{
  "expect": [
    {
      "rule": "no-literal-arn",
      "blockId": "text-back",
      "messageIncludes": "Parameter \"SourceEndpoint.Address\" contains a literal ARN"
    }
  ],
  "doc": {
    "flowdoc": "0.3",
    "kind": "flow",
    "name": "text-back",
    "connectType": "CONTACT_FLOW",
    "content": {
      "Version": "2019-10-30",
      "StartAction": "text-back",
      "Actions": [
        {
          "Identifier": "text-back",
          "Type": "StartOutboundChatContact",
          "Parameters": {
            "ContactFlowArn": "${cdref:flow:sms-follow-up}",
            "ContactSubtype": "connect:SMS",
            "DestinationEndpoint": {
              "Address": "$.CustomerEndpoint.Address",
              "Type": "TELEPHONE_NUMBER"
            },
            "SourceEndpoint": {
              "Address": "arn:aws:connect:us-east-1:111122223333:phone-number/aaaa0000-0000-4000-8000-000000000001",
              "Type": "CONNECT_PHONENUMBER_ARN"
            }
          },
          "Transitions": {
            "NextAction": "bye",
            "Errors": [
              {
                "ErrorType": "NoMatchingError",
                "NextAction": "bye"
              }
            ],
            "Conditions": []
          }
        },
        {
          "Identifier": "bye",
          "Type": "DisconnectParticipant",
          "Parameters": {},
          "Transitions": {}
        }
      ]
    },
    "layout": {
      "text-back": {
        "x": 0,
        "y": 0
      },
      "bye": {
        "x": 200,
        "y": 0
      }
    },
    "refs": [
      {
        "token": "${cdref:flow:sms-follow-up}",
        "type": "flow",
        "name": "sms-follow-up"
      }
    ]
  }
}
