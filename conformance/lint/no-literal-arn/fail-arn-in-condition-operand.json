{
  "expect": [
    {
      "rule": "no-literal-arn",
      "blockId": "cmp",
      "messageIncludes": "literal ARN"
    }
  ],
  "doc": {
    "flowdoc": "0.1",
    "kind": "flow",
    "name": "case",
    "connectType": "CONTACT_FLOW",
    "content": {
      "Version": "2019-10-30",
      "StartAction": "cmp",
      "Actions": [
        {
          "Identifier": "cmp",
          "Type": "Compare",
          "Parameters": {
            "ComparisonValue": "$.Attributes.tier"
          },
          "Transitions": {
            "Errors": [
              {
                "ErrorType": "NoMatchingCondition",
                "NextAction": "bye"
              }
            ],
            "Conditions": [
              {
                "NextAction": "bye",
                "Condition": {
                  "Operator": "Equals",
                  "Operands": [
                    "arn:aws:connect:us-east-1:111122223333:instance/EXAMPLE/queue/EXAMPLE"
                  ]
                }
              }
            ]
          }
        },
        {
          "Identifier": "bye",
          "Type": "DisconnectParticipant",
          "Parameters": {},
          "Transitions": {}
        }
      ]
    },
    "layout": {
      "cmp": {
        "x": 0,
        "y": 0
      },
      "bye": {
        "x": 200,
        "y": 0
      }
    },
    "refs": []
  }
}
