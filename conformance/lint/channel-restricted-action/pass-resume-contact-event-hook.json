{
  "flowdoc": "0.3",
  "kind": "flow",
  "name": "set-resume-hook",
  "description": "The ResumeContact event hook names a flow to run when a contact resumes; it is not the ResumeContact action, and no channel restriction applies to it.",
  "connectType": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "set-resume-flow",
    "Actions": [
      {
        "Identifier": "set-resume-flow",
        "Type": "UpdateContactEventHooks",
        "Parameters": {
          "EventHooks": {
            "ResumeContact": "${cdref:flow:on-resume}"
          }
        },
        "Transitions": {
          "NextAction": "bye",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "bye"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "bye",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  },
  "layout": {
    "set-resume-flow": {
      "x": 0,
      "y": 0
    },
    "bye": {
      "x": 200,
      "y": 0
    }
  },
  "refs": [
    {
      "token": "${cdref:flow:on-resume}",
      "type": "flow",
      "name": "on-resume"
    }
  ]
}
