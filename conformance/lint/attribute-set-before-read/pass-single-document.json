{
  "flowdoc": "0.2",
  "kind": "flow",
  "name": "agent-whisper",
  "connectType": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "whisper",
    "Actions": [
      {
        "Identifier": "whisper",
        "Type": "MessageParticipant",
        "Parameters": {
          "Text": "Caller is $.Attributes.callerName, tier $.Attributes.tier."
        },
        "Transitions": {
          "NextAction": "bye",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "bye"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "bye",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
