{
  "expect": [
    {
      "rule": "error-branches",
      "blockId": "staffed",
      "messageIncludes": "needs at least 1 condition"
    }
  ],
  "doc": {
    "flowdoc": "0.3",
    "kind": "flow",
    "name": "case",
    "connectType": "CONTACT_FLOW",
    "content": {
      "Version": "2019-10-30",
      "StartAction": "staffed",
      "Actions": [
        {
          "Identifier": "staffed",
          "Type": "CheckMetricData",
          "Parameters": {
            "MetricType": "NumberOfAgentsStaffed",
            "QueueId": "$.Attributes.queueArn"
          },
          "Transitions": {
            "NextAction": "bye",
            "Errors": [
              {
                "ErrorType": "NoMatchingError",
                "NextAction": "bye"
              },
              {
                "ErrorType": "NoMatchingCondition",
                "NextAction": "bye"
              }
            ],
            "Conditions": []
          }
        },
        {
          "Identifier": "bye",
          "Type": "DisconnectParticipant",
          "Parameters": {},
          "Transitions": {}
        }
      ]
    },
    "layout": {
      "bye": {
        "x": 280,
        "y": 20
      },
      "staffed": {
        "x": 20,
        "y": 20
      }
    },
    "refs": []
  }
}
