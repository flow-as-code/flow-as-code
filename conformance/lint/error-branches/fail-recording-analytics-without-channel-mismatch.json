{
  "expect": [
    {
      "rule": "error-branches",
      "blockId": "record",
      "messageIncludes": "ChannelMismatch"
    }
  ],
  "doc": {
    "flowdoc": "0.2",
    "kind": "flow",
    "name": "case",
    "connectType": "CONTACT_FLOW",
    "content": {
      "Version": "2019-10-30",
      "StartAction": "announce",
      "Actions": [
        {
          "Identifier": "announce",
          "Type": "MessageParticipant",
          "Parameters": {
            "Text": "This call may be recorded."
          },
          "Transitions": {
            "NextAction": "record",
            "Errors": [
              {
                "ErrorType": "NoMatchingError",
                "NextAction": "record"
              }
            ],
            "Conditions": []
          }
        },
        {
          "Identifier": "record",
          "Type": "UpdateContactRecordingAndAnalyticsBehavior",
          "Parameters": {
            "VoiceBehavior": {
              "VoiceRecordingBehavior": {
                "RecordedParticipants": [
                  "Agent",
                  "Customer"
                ]
              }
            }
          },
          "Transitions": {
            "NextAction": "bye",
            "Errors": [
              {
                "ErrorType": "NoMatchingError",
                "NextAction": "bye"
              }
            ],
            "Conditions": []
          }
        },
        {
          "Identifier": "bye",
          "Type": "DisconnectParticipant",
          "Parameters": {},
          "Transitions": {}
        }
      ]
    },
    "layout": {
      "announce": {
        "x": 20,
        "y": 20
      },
      "record": {
        "x": 280,
        "y": 20
      },
      "bye": {
        "x": 540,
        "y": 20
      }
    },
    "refs": []
  }
}
