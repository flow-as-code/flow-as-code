{
  "expect": [
    {
      "rule": "error-branches",
      "blockId": "show",
      "messageIncludes": "\"NoMatchingCondition\""
    }
  ],
  "doc": {
    "flowdoc": "0.3",
    "kind": "flow",
    "name": "case",
    "connectType": "CONTACT_FLOW",
    "content": {
      "Version": "2019-10-30",
      "StartAction": "show",
      "Actions": [
        {
          "Identifier": "show",
          "Type": "ShowView",
          "Parameters": {
            "InvocationTimeLimitSeconds": "300",
            "ViewResource": {
              "Id": "$.Attributes.view"
            }
          },
          "Transitions": {
            "NextAction": "bye",
            "Errors": [
              {
                "ErrorType": "NoMatchingError",
                "NextAction": "bye"
              },
              {
                "ErrorType": "TimeLimitExceeded",
                "NextAction": "bye"
              }
            ],
            "Conditions": []
          }
        },
        {
          "Identifier": "bye",
          "Type": "DisconnectParticipant",
          "Parameters": {},
          "Transitions": {}
        }
      ]
    },
    "layout": {
      "show": {
        "x": 20,
        "y": 20
      },
      "bye": {
        "x": 280,
        "y": 20
      }
    },
    "refs": []
  }
}
