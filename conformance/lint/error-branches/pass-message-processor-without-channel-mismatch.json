{
  "flowdoc": "0.3",
  "kind": "flow",
  "name": "chat-redaction",
  "description": "The chat message processor with the catch-all alone: its page does not say ChannelMismatch must be defined, so error-branches does not require it until a create the service refuses says otherwise (actions.md, rule 41, probe pending).",
  "connectType": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "process-messages",
    "Actions": [
      {
        "Identifier": "process-messages",
        "Type": "UpdateContactMediaProcessing",
        "Parameters": {
          "ChatProcessor": {
            "ProcessingEnabled": "True",
            "LambdaProcessorARN": "${cdref:lambda:message-redactor}",
            "ChatProcessorSettings": {
              "DeliverUnprocessedMessages": "True"
            }
          }
        },
        "Transitions": {
          "NextAction": "bye",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "bye"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "bye",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  },
  "layout": {
    "process-messages": {
      "x": 0,
      "y": 0
    },
    "bye": {
      "x": 200,
      "y": 0
    }
  },
  "refs": [
    {
      "token": "${cdref:lambda:message-redactor}",
      "type": "lambda",
      "name": "message-redactor"
    }
  ]
}
