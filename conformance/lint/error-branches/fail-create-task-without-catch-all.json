{
  "expect": [
    {
      "rule": "error-branches",
      "blockId": "follow-up",
      "messageIncludes": "CreateTask does not wire its \"NoMatchingError\" branch"
    }
  ],
  "doc": {
    "flowdoc": "0.3",
    "kind": "flow",
    "name": "task-follow-up",
    "connectType": "CONTACT_FLOW",
    "content": {
      "Version": "2019-10-30",
      "StartAction": "follow-up",
      "Actions": [
        {
          "Identifier": "follow-up",
          "Type": "CreateTask",
          "Parameters": {
            "Name": "Follow up",
            "TaskTemplateId": "${cdref:tasktemplate:follow-up}"
          },
          "Transitions": {
            "NextAction": "bye",
            "Errors": [],
            "Conditions": []
          }
        },
        {
          "Identifier": "bye",
          "Type": "DisconnectParticipant",
          "Parameters": {},
          "Transitions": {}
        }
      ]
    },
    "layout": {
      "follow-up": {
        "x": 0,
        "y": 0
      },
      "bye": {
        "x": 200,
        "y": 0
      }
    },
    "refs": [
      {
        "token": "${cdref:tasktemplate:follow-up}",
        "type": "tasktemplate",
        "name": "follow-up"
      }
    ]
  }
}
