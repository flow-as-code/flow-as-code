{
  "flowdoc": "0.3",
  "kind": "flow",
  "name": "call-out",
  "connectType": "OUTBOUND_WHISPER",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "place-call",
    "Actions": [
      {
        "Identifier": "place-call",
        "Type": "CompleteOutboundCall",
        "Parameters": {
          "CallerId": {
            "Number": "$.Attributes.callerId"
          }
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "EndFlowExecution",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  },
  "layout": {
    "place-call": {
      "x": 0,
      "y": 0
    },
    "done": {
      "x": 200,
      "y": 0
    }
  },
  "refs": []
}
