{
  "flowdoc": "0.3",
  "kind": "flow",
  "name": "customer-profile-check",
  "description": "The page lists MultipleFoundError and NoneFoundError without marking either \"Must always be defined\", so only the catch-all is required until rule 43 records the service refusing a removal.",
  "connectType": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "find-caller",
    "Actions": [
      {
        "Identifier": "find-caller",
        "Type": "GetCustomerProfile",
        "Parameters": {
          "ProfileRequestData": {
            "IdentifierName": "_phone",
            "IdentifierValue": "$.CustomerEndpoint.Address"
          },
          "ProfileResponseData": [
            "FirstName"
          ]
        },
        "Transitions": {
          "NextAction": "bye",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "bye"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "bye",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  },
  "layout": {
    "find-caller": {
      "x": 0,
      "y": 0
    },
    "bye": {
      "x": 200,
      "y": 0
    }
  },
  "refs": []
}
