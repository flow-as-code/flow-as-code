{
  "flowdoc": "0.3",
  "kind": "flow",
  "name": "case-lookup",
  "description": "The page lists MultipleFound and NoneFound without marking either \"Must always be defined\", and ContactNotLinked is required only when linking, so a lookup that does not link wires the catch-all alone until rule 44 records the service refusing a removal.",
  "connectType": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "find-case",
    "Actions": [
      {
        "Identifier": "find-case",
        "Type": "GetCase",
        "Parameters": {
          "LinkContactToCase": "false",
          "GetLastUpdatedCase": "true",
          "CaseRequestFields": {
            "customer_id": "$.Customer.ProfileARN"
          },
          "CaseResponseFields": [
            "case_id",
            "status"
          ]
        },
        "Transitions": {
          "NextAction": "bye",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "bye"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "bye",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  },
  "layout": {
    "find-case": {
      "x": 0,
      "y": 0
    },
    "bye": {
      "x": 200,
      "y": 0
    }
  },
  "refs": []
}
