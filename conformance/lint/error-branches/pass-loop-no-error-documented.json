{
  "flowdoc": "0.3",
  "kind": "flow",
  "name": "case",
  "connectType": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "say",
    "Actions": [
      {
        "Identifier": "say",
        "Type": "MessageParticipant",
        "Parameters": {
          "Text": "Hello again."
        },
        "Transitions": {
          "NextAction": "again",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "bye"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "again",
        "Type": "Loop",
        "Parameters": {
          "LoopCount": "2"
        },
        "Transitions": {
          "NextAction": "bye",
          "Errors": [],
          "Conditions": [
            {
              "NextAction": "say",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "ContinueLooping"
                ]
              }
            },
            {
              "NextAction": "bye",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "DoneLooping"
                ]
              }
            }
          ]
        }
      },
      {
        "Identifier": "bye",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  },
  "layout": {
    "say": {
      "x": 20,
      "y": 20
    },
    "again": {
      "x": 280,
      "y": 20
    },
    "bye": {
      "x": 540,
      "y": 20
    }
  },
  "refs": []
}
