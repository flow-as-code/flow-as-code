{
  "expect": [
    {
      "rule": "error-branches",
      "blockId": "update-case",
      "messageIncludes": "UpdateCase does not wire its \"ContactNotLinked\" branch"
    }
  ],
  "doc": {
    "flowdoc": "0.3",
    "kind": "flow",
    "name": "case-update",
    "connectType": "CONTACT_FLOW",
    "content": {
      "Version": "2019-10-30",
      "StartAction": "update-case",
      "Actions": [
        {
          "Identifier": "update-case",
          "Type": "UpdateCase",
          "Parameters": {
            "LinkContactToCase": "true",
            "CaseId": "$.Case.case_id",
            "CaseRequestFields": {
              "status": "closed"
            }
          },
          "Transitions": {
            "NextAction": "bye",
            "Errors": [
              {
                "ErrorType": "NoMatchingError",
                "NextAction": "bye"
              }
            ],
            "Conditions": []
          }
        },
        {
          "Identifier": "bye",
          "Type": "DisconnectParticipant",
          "Parameters": {},
          "Transitions": {}
        }
      ]
    },
    "layout": {
      "update-case": {
        "x": 0,
        "y": 0
      },
      "bye": {
        "x": 200,
        "y": 0
      }
    },
    "refs": []
  }
}
