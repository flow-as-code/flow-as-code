{
  "expect": [
    {
      "rule": "conditional-shape",
      "blockId": "ask",
      "messageIncludes": "without StoreInput \"True\" must not carry InputValidation"
    },
    {
      "rule": "conditional-shape",
      "blockId": "ask",
      "messageIncludes": "without StoreInput \"True\" must not wire the \"InvalidPhoneNumber\" branch"
    }
  ],
  "doc": {
    "flowdoc": "0.2",
    "kind": "flow",
    "name": "case",
    "connectType": "CONTACT_FLOW",
    "content": {
      "Version": "2019-10-30",
      "StartAction": "ask",
      "Actions": [
        {
          "Identifier": "ask",
          "Type": "GetParticipantInput",
          "Parameters": {
            "Text": "Press 1 or 2.",
            "InputTimeLimitSeconds": "5",
            "InputValidation": {
              "PhoneNumberValidation": {
                "NumberFormat": "E164"
              }
            }
          },
          "Transitions": {
            "NextAction": "bye",
            "Errors": [
              {
                "ErrorType": "InputTimeLimitExceeded",
                "NextAction": "bye"
              },
              {
                "ErrorType": "InvalidPhoneNumber",
                "NextAction": "bye"
              },
              {
                "ErrorType": "NoMatchingCondition",
                "NextAction": "bye"
              },
              {
                "ErrorType": "NoMatchingError",
                "NextAction": "bye"
              }
            ],
            "Conditions": [
              {
                "NextAction": "bye",
                "Condition": {
                  "Operator": "Equals",
                  "Operands": [
                    "1"
                  ]
                }
              }
            ]
          }
        },
        {
          "Identifier": "bye",
          "Type": "DisconnectParticipant",
          "Parameters": {},
          "Transitions": {}
        }
      ]
    },
    "layout": {
      "ask": {
        "x": 20,
        "y": 20
      },
      "bye": {
        "x": 280,
        "y": 20
      }
    },
    "refs": []
  }
}
