{
  "expect": [
    {
      "rule": "conditional-shape",
      "blockId": "open-case",
      "messageIncludes": "ContactNotLinked"
    }
  ],
  "doc": {
    "flowdoc": "0.3",
    "kind": "flow",
    "name": "case-intake",
    "description": "CreateCase that does not link (LinkContactToCase \"false\") with ContactNotLinked wired. The service refuses that branch on a non-linking block (\"Invalid Action error. Error: ContactNotLinked\", actions.md, rule 44, 2026-10-13), so the shape forbids it.",
    "connectType": "CONTACT_FLOW",
    "content": {
      "Version": "2019-10-30",
      "StartAction": "open-case",
      "Actions": [
        {
          "Identifier": "open-case",
          "Type": "CreateCase",
          "Parameters": {
            "LinkContactToCase": "false",
            "CaseTemplateId": "${cdref:casetemplate:billing-dispute}",
            "CaseRequestFields": {
              "customer_id": "$.Customer.ProfileARN",
              "summary": "$.Attributes.summary"
            }
          },
          "Transitions": {
            "NextAction": "bye",
            "Errors": [
              {
                "ErrorType": "ContactNotLinked",
                "NextAction": "bye"
              },
              {
                "ErrorType": "NoMatchingError",
                "NextAction": "bye"
              }
            ],
            "Conditions": []
          }
        },
        {
          "Identifier": "bye",
          "Type": "DisconnectParticipant",
          "Parameters": {},
          "Transitions": {}
        }
      ]
    },
    "layout": {
      "open-case": {
        "x": 0,
        "y": 0
      },
      "bye": {
        "x": 200,
        "y": 0
      }
    },
    "refs": [
      {
        "token": "${cdref:casetemplate:billing-dispute}",
        "type": "casetemplate",
        "name": "billing-dispute"
      }
    ]
  }
}
