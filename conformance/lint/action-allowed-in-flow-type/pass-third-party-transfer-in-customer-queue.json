{
  "flowdoc": "0.3",
  "kind": "flow",
  "name": "queue-desk-transfer",
  "description": "A transfer to a phone number in a customer queue flow, which the block page lists.",
  "connectType": "CUSTOMER_QUEUE",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "transfer-desk",
    "Actions": [
      {
        "Identifier": "transfer-desk",
        "Type": "TransferParticipantToThirdParty",
        "Parameters": {
          "ContinueFlowExecution": "True",
          "ThirdPartyConnectionTimeLimitSeconds": "30",
          "ThirdPartyPhoneNumber": "$.Attributes.deskPhone"
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "CallFailed",
              "NextAction": "done"
            },
            {
              "ErrorType": "ConnectionTimeLimitExceeded",
              "NextAction": "done"
            },
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  },
  "layout": {
    "transfer-desk": {
      "x": 0,
      "y": 0
    },
    "done": {
      "x": 260,
      "y": 0
    }
  },
  "refs": []
}
