{
  "expect": [
    {
      "rule": "action-allowed-in-flow-type",
      "blockId": "requeue",
      "messageIncludes": "DequeueContactAndTransferToQueue is not allowed in a CONTACT_FLOW flow"
    }
  ],
  "doc": {
    "flowdoc": "0.3",
    "kind": "flow",
    "name": "case",
    "connectType": "CONTACT_FLOW",
    "content": {
      "Version": "2019-10-30",
      "StartAction": "requeue",
      "Actions": [
        {
          "Identifier": "requeue",
          "Type": "DequeueContactAndTransferToQueue",
          "Parameters": {
            "QueueId": "${cdref:queue:priority}"
          },
          "Transitions": {
            "NextAction": "bye",
            "Errors": [
              {
                "ErrorType": "QueueAtCapacity",
                "NextAction": "bye"
              },
              {
                "ErrorType": "NoMatchingError",
                "NextAction": "bye"
              }
            ],
            "Conditions": []
          }
        },
        {
          "Identifier": "bye",
          "Type": "DisconnectParticipant",
          "Parameters": {},
          "Transitions": {}
        }
      ]
    },
    "layout": {
      "requeue": {
        "x": 20,
        "y": 20
      },
      "bye": {
        "x": 280,
        "y": 20
      }
    },
    "refs": [
      {
        "token": "${cdref:queue:priority}",
        "type": "queue",
        "name": "priority"
      }
    ]
  }
}
