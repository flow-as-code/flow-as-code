{
  "expect": [
    {
      "rule": "action-allowed-in-flow-type",
      "blockId": "transfer-desk",
      "messageIncludes": "TransferParticipantToThirdParty is not allowed in a CUSTOMER_WHISPER"
    }
  ],
  "doc": {
    "flowdoc": "0.3",
    "kind": "flow",
    "name": "whisper-desk-transfer",
    "description": "A transfer to a phone number in a customer whisper flow, which the Transfer to phone number block page does not list.",
    "connectType": "CUSTOMER_WHISPER",
    "content": {
      "Version": "2019-10-30",
      "StartAction": "transfer-desk",
      "Actions": [
        {
          "Identifier": "transfer-desk",
          "Type": "TransferParticipantToThirdParty",
          "Parameters": {
            "ContinueFlowExecution": "True",
            "ThirdPartyConnectionTimeLimitSeconds": "30",
            "ThirdPartyPhoneNumber": "$.Attributes.deskPhone"
          },
          "Transitions": {
            "NextAction": "done",
            "Errors": [
              {
                "ErrorType": "CallFailed",
                "NextAction": "done"
              },
              {
                "ErrorType": "ConnectionTimeLimitExceeded",
                "NextAction": "done"
              },
              {
                "ErrorType": "NoMatchingError",
                "NextAction": "done"
              }
            ],
            "Conditions": []
          }
        },
        {
          "Identifier": "done",
          "Type": "EndFlowExecution",
          "Parameters": {},
          "Transitions": {}
        }
      ]
    },
    "layout": {
      "transfer-desk": {
        "x": 0,
        "y": 0
      },
      "done": {
        "x": 260,
        "y": 0
      }
    },
    "refs": []
  }
}
