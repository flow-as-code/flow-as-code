{
  "name": "queue-by-token",
  "description": "The same transfer, with the queue reached asserted by token: expect-queue's queue form compiles to an Assert on $.Queue.ARN whose Operand the resource map resolves, so the scenario names the queue the way the flow does and never a console name.",
  "entryPoint": {
    "Type": "VOICE_CALL",
    "VoiceCallEntryPointParameters": {
      "SourcePhoneNumber": "+15550100",
      "FlowId": "${cdref:flow:appointment-line}"
    }
  },
  "content": {
    "Version": "2019-10-30",
    "Metadata": {},
    "Observations": [
      {
        "Identifier": "observation-1",
        "Event": {
          "Identifier": "observation-1-event",
          "Type": "TestInitiated",
          "Actor": "System",
          "Properties": {}
        },
        "Actions": [
          {
            "Identifier": "observation-1-action-1",
            "Type": "OverrideSystemBehavior",
            "Parameters": {
              "ActionType": "OverrideSystemBehavior",
              "Behavior": {
                "Type": "FlowAction",
                "Properties": {
                  "ActionType": "TransferContactToQueue",
                  "ActionParameters": {
                    "QueueId": "${cdref:queue:appointments}"
                  },
                  "Strategy": {
                    "Type": "SubstituteResource",
                    "SubstituteArn": "${cdref:queue:overflow}"
                  }
                }
              }
            },
            "Transitions": {}
          }
        ],
        "Transitions": {
          "NextObservations": [
            "observation-2"
          ]
        }
      },
      {
        "Identifier": "observation-2",
        "Event": {
          "Identifier": "observation-2-event",
          "Type": "FlowActionStarted",
          "Actor": "System",
          "Properties": {
            "ActionType": "CheckHoursOfOperation",
            "ActionParameters": {
              "HoursOfOperationId": "${cdref:hours:main-line}"
            }
          }
        },
        "Actions": [],
        "Transitions": {
          "NextObservations": [
            "observation-3"
          ]
        }
      },
      {
        "Identifier": "observation-3",
        "Event": {
          "Identifier": "observation-3-event",
          "Type": "FlowActionStarted",
          "Actor": "System",
          "Properties": {
            "ActionType": "InvokeLambdaFunction",
            "ActionParameters": {
              "LambdaFunctionARN": "${cdref:lambda:appointment-lookup}"
            }
          }
        },
        "Actions": [],
        "Transitions": {
          "NextObservations": [
            "observation-4"
          ]
        }
      },
      {
        "Identifier": "observation-4",
        "Event": {
          "Identifier": "observation-4-event",
          "Type": "FlowActionStarted",
          "Actor": "System",
          "Properties": {
            "ActionType": "TransferContactToQueue",
            "ActionParameters": {
              "QueueId": "${cdref:queue:appointments}"
            }
          }
        },
        "Actions": [
          {
            "Identifier": "observation-4-action-1",
            "Type": "Assert",
            "Parameters": {
              "Namespace": "$.Queue.ARN",
              "Operator": "Equals",
              "Operand": "${cdref:queue:appointments}"
            },
            "Transitions": {
              "NextAction": "observation-4-action-2"
            }
          },
          {
            "Identifier": "observation-4-action-2",
            "Type": "TestControl",
            "Parameters": {
              "ActionType": "TestControl",
              "Command": {
                "Type": "EndTest"
              }
            },
            "Transitions": {}
          }
        ],
        "Transitions": {
          "NextObservations": []
        }
      }
    ]
  }
}
