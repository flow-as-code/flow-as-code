{
  "Version": "2019-10-30",
  "StartAction": "place-call",
  "Actions": [
    {
      "Identifier": "place-call",
      "Type": "CompleteOutboundCall",
      "Parameters": {
        "CallerId": {
          "Number": "+15555550110"
        }
      },
      "Transitions": {
        "NextAction": "check-progress",
        "Errors": [],
        "Conditions": []
      }
    },
    {
      "Identifier": "check-progress",
      "Type": "CheckOutboundCallStatus",
      "Parameters": {},
      "Transitions": {
        "NextAction": "done",
        "Errors": [
          {
            "ErrorType": "NoMatchingError",
            "NextAction": "done"
          }
        ],
        "Conditions": [
          {
            "NextAction": "done",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "CallAnswered"
              ]
            }
          },
          {
            "NextAction": "text-back",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "VoicemailBeep"
              ]
            }
          }
        ]
      }
    },
    {
      "Identifier": "text-back",
      "Type": "StartOutboundChatContact",
      "Parameters": {
        "SourceEndpoint": {
          "Address": "arn:aws:connect:us-east-1:111122223333:phone-number/pppp7777-0000-4000-8000-000000000051",
          "Type": "CONNECT_PHONENUMBER_ARN"
        },
        "DestinationEndpoint": {
          "Address": "$.CustomerEndpoint.Address",
          "Type": "TELEPHONE_NUMBER"
        },
        "ContactFlowArn": "arn:aws:connect:us-east-1:111122223333:instance/11111111-2222-3333-4444-555555555555/contact-flow/cccc3333-0000-4000-8000-000000000052",
        "ContactSubtype": "connect:SMS",
        "InitialSystemMessage": {
          "Content": "We tried to call you. Reply here to continue."
        },
        "RelatedContact": "CURRENT"
      },
      "Transitions": {
        "NextAction": "done",
        "Errors": [
          {
            "ErrorType": "NoMatchingError",
            "NextAction": "done"
          }
        ],
        "Conditions": []
      }
    },
    {
      "Identifier": "done",
      "Type": "EndFlowExecution",
      "Parameters": {},
      "Transitions": {}
    }
  ]
}
