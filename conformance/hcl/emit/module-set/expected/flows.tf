resource "flowascode_contact_flow" "support_line" {
  instance_id = var.connect_instance_id
  name        = "support-line"
  type        = "CONTACT_FLOW"

  refs = {
    "module:after-call-survey@prod" = flowascode_contact_flow_module_alias.after_call_survey_prod.arn
    "queue:appointments"            = aws_connect_queue.appointments.arn
  }

  action {
    id   = "welcome"
    next = "set-queue"
    message_participant {
      text = "Thanks for calling support."
    }
    error {
      type = "NoMatchingError"
      next = "survey"
    }
  }

  action {
    id   = "set-queue"
    next = "survey"
    update_contact_target_queue {
      queue_id = "queue:appointments"
    }
    error {
      type = "NoMatchingError"
      next = "survey"
    }
  }

  action {
    id   = "survey"
    next = "hang-up"
    invoke_flow_module {
      flow_module_id = "module:after-call-survey@prod"
    }
    error {
      type = "NoMatchingError"
      next = "hang-up"
    }
  }

  action {
    id = "hang-up"
    disconnect_participant {}
  }
}
