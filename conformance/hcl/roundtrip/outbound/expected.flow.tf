# Generated by @flow-as-code/hcl from doc.flowdoc.json.
# Edits to structure regenerate; comments marked @keep survive.

resource "flowascode_contact_flow" "outbound" {
  instance_id = var.connect_instance_id
  name        = "outbound"
  type        = "OUTBOUND_WHISPER"
  description = "The outbound actions in an outbound whisper flow: the call placed with a static caller ID, or through a Chime voice connector (generic, owner decision 4); its progress checked on all four statuses; a person greeted; on voicemail an SMS from the claimed number and flow by reference, with a message, linked to the contact; and with no detection an SMS from a number and flow read from attributes."

  refs = {
    "flow:sms-follow-up"   = flowascode_contact_flow.sms_follow_up.arn
    "phonenumber:main-did" = aws_connect_phone_number.main_did.arn
  }

  action {
    id   = "choose-route"
    next = "place-call"
    compare {
      comparison_value = "$.Attributes.route"
    }
    condition {
      operator = "Equals"
      operands = ["sip"]
      next     = "place-call-via-sip"
    }
    error {
      type = "NoMatchingCondition"
      next = "place-call"
    }
  }

  action {
    id   = "place-call"
    next = "check-progress"
    complete_outbound_call {
      caller_id = {
        number = "+15555550100"
      }
    }
  }

  action {
    id   = "place-call-via-sip"
    next = "check-progress"
    generic {
      type = "CompleteOutboundCall"
      parameters = jsonencode({
        ConnectionTimeLimitSeconds = "30"
        VoiceConnector = {
          FromUser           = "$.Attributes.fromUser"
          ToUser             = "$.CustomerEndpoint.Address"
          VoiceConnectorArn  = "$.Attributes.voiceConnectorArn"
          VoiceConnectorType = "ChimeConnector"
        }
      })
    }
    position {
      x = 280
      y = 180
    }
  }

  action {
    id   = "check-progress"
    next = "done"
    check_outbound_call_status {}
    condition {
      operator = "Equals"
      operands = ["CallAnswered"]
      next     = "greet"
    }
    condition {
      operator = "Equals"
      operands = ["VoicemailBeep"]
      next     = "text-back"
    }
    condition {
      operator = "Equals"
      operands = ["VoicemailNoBeep"]
      next     = "text-back"
    }
    condition {
      operator = "Equals"
      operands = ["NotDetected"]
      next     = "text-from-attributes"
    }
    error {
      type = "NoMatchingError"
      next = "done"
    }
  }

  action {
    id   = "greet"
    next = "done"
    message_participant {
      text = "Connecting you to the customer."
    }
  }

  action {
    id   = "text-back"
    next = "leave-message"
    start_outbound_chat_contact {
      contact_flow_arn = "flow:sms-follow-up"
      contact_subtype  = "connect:SMS"
      destination_endpoint = {
        address = "$.CustomerEndpoint.Address"
        type    = "TELEPHONE_NUMBER"
      }
      initial_system_message = {
        content = "We tried to call you. Reply here to pick up where we left off."
      }
      related_contact = "CURRENT"
      source_endpoint = {
        address = "phonenumber:main-did"
        type    = "CONNECT_PHONENUMBER_ARN"
      }
    }
    error {
      type = "NoMatchingError"
      next = "leave-message"
    }
    position {
      x = 800
      y = 180
    }
  }

  action {
    id   = "text-from-attributes"
    next = "done"
    start_outbound_chat_contact {
      contact_flow_arn = "$.Attributes.smsFlowArn"
      contact_subtype  = "connect:SMS"
      destination_endpoint = {
        address = "+15555550101"
        type    = "TELEPHONE_NUMBER"
      }
      source_endpoint = {
        address = "$.Attributes.smsNumberArn"
        type    = "CONNECT_PHONENUMBER_ARN"
      }
    }
    error {
      type = "NoMatchingError"
      next = "done"
    }
    position {
      x = 800
      y = 340
    }
  }

  action {
    id   = "leave-message"
    next = "done"
    message_participant {
      text = "The call reached voicemail."
    }
    position {
      x = 1060
      y = 180
    }
  }

  action {
    id = "done"
    end_flow_execution {}
  }
}
