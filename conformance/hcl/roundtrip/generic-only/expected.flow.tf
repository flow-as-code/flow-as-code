# Generated by @flow-as-code/hcl from doc.flowdoc.json.
# Edits to structure regenerate; comments marked @keep survive.

resource "flowascode_contact_flow" "unknown_actions" {
  instance_id = var.connect_instance_id
  name        = "unknown-actions"
  type        = "CONTACT_FLOW"

  refs = {
    "flow:task-flow" = flowascode_contact_flow.task_flow.arn
    "queue:support"  = aws_connect_queue.support.arn
  }

  action {
    id   = "text-back"
    next = "dial-connector"
    generic {
      type = "StartOutboundChatContact"
      parameters = jsonencode({
        ContactFlowArn = "$${cdref:flow:task-flow}"
        ContactSubtype = "connect:WhatsApp"
        DestinationEndpoint = {
          Address = "$.CustomerEndpoint.Address"
          Type    = "TELEPHONE_NUMBER"
        }
        InitialTemplatedSystemMessage = {
          KnowledgeBaseId   = "$.Attributes.knowledgeBaseId"
          MessageTemplateId = "$.Attributes.messageTemplateId"
        }
        SourceEndpoint = {
          Address = "$.Attributes.smsNumberArn"
          Type    = "CONNECT_PHONENUMBER_ARN"
        }
      })
    }
    error {
      type = "NoMatchingError"
      next = "hand-off"
    }
  }

  action {
    id   = "dial-connector"
    next = "load-content"
    generic {
      type = "CompleteOutboundCall"
      parameters = jsonencode({
        VoiceConnector = {
          FromUser              = "$.Attributes.fromUser"
          ToUser                = "$.CustomerEndpoint.Address"
          UserToUserInformation = "$${cdref:queue:support}"
          VoiceConnectorArn     = "$.Attributes.voiceConnectorArn"
          VoiceConnectorType    = "ChimeConnector"
        }
      })
    }
  }

  action {
    id   = "load-content"
    next = "transfer-third-party"
    generic {
      type = "LoadContactContent"
      parameters = jsonencode({
        ContentType = "EmailMessage"
      })
    }
    error {
      type = "NoMatchingError"
      next = "hand-off"
    }
  }

  action {
    id   = "transfer-third-party"
    next = "hand-off"
    generic {
      type = "TransferParticipantToThirdParty"
      parameters = jsonencode({
        ContinueFlowExecution                = "True"
        ThirdPartyConnectionTimeLimitSeconds = "30"
        ThirdPartyPhoneNumber                = "$.Attributes.deskPhone"
      })
    }
    error {
      type = "CallFailed"
      next = "hand-off"
    }
    error {
      type = "ConnectionTimeLimitExceeded"
      next = "hand-off"
    }
    error {
      type = "NoMatchingError"
      next = "hand-off"
    }
  }

  action {
    id   = "hand-off"
    next = "load-content"
    generic {
      type = "StartVoiceIdStream"
    }
    error {
      type = "NoMatchingError"
      next = "load-content"
    }
  }
}
