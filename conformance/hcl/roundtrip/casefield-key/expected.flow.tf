resource "flowascode_contact_flow" "casefield_key" {
  instance_id = var.connect_instance_id
  name        = "casefield-key"
  type        = "CONTACT_FLOW"

  refs = {
    "assistant:agent-help"         = awscc_wisdom_assistant.agent_help.assistant_arn
    "casefield:priority"           = awscc_connectcases_field.priority.field_id
    "casefield:summary"            = awscc_connectcases_field.summary.field_id
    "casetemplate:billing-dispute" = awscc_connectcases_template.billing_dispute.template_id
    "flow:task-line"               = flowascode_contact_flow.task_line.arn
    "phonenumber:main-did"         = aws_connect_phone_number.main_did.arn
    "tasktemplate:follow-up"       = awscc_connect_task_template.follow_up.arn
  }

  action {
    id   = "open-case"
    next = "read-case"
    create_case {
      case_request_fields = {
        "casefield:priority" = "high"
        "casefield:summary"  = "$.Attributes.summary"
      }
      case_template_id     = "casetemplate:billing-dispute"
      link_contact_to_case = "true"
    }
    error {
      type = "ContactNotLinked"
      next = "hang-up"
    }
    error {
      type = "NoMatchingError"
      next = "hang-up"
    }
  }

  action {
    id   = "read-case"
    next = "follow-up"
    get_case {
      case_response_fields  = ["casefield:priority"]
      customer_id           = "$.Customer.ProfileId"
      get_last_updated_case = "true"
      link_contact_to_case  = "false"
    }
    error {
      type = "NoMatchingError"
      next = "hang-up"
    }
    position {
      x = 340
      y = 20
    }
  }

  action {
    id   = "follow-up"
    next = "assist"
    create_task {
      contact_flow_id  = "flow:task-line"
      name             = "Follow up"
      task_template_id = "tasktemplate:follow-up"
    }
    error {
      type = "NoMatchingError"
      next = "hang-up"
    }
    position {
      x = 660
      y = 20
    }
  }

  action {
    id   = "assist"
    next = "text-back"
    create_wisdom_session {
      wisdom_assistant_arn = "assistant:agent-help"
    }
    error {
      type = "NoMatchingError"
      next = "hang-up"
    }
    position {
      x = 980
      y = 20
    }
  }

  action {
    id   = "text-back"
    next = "hang-up"
    start_outbound_chat_contact {
      contact_flow_arn = "flow:task-line"
      contact_subtype  = "connect:SMS"
      destination_endpoint = {
        address = "$.CustomerEndpoint.Address"
        type    = "TELEPHONE_NUMBER"
      }
      source_endpoint = {
        address = "phonenumber:main-did"
        type    = "CONNECT_PHONENUMBER_ARN"
      }
    }
    error {
      type = "NoMatchingError"
      next = "hang-up"
    }
    position {
      x = 1300
      y = 20
    }
  }

  action {
    id = "hang-up"
    disconnect_participant {}
    position {
      x = 1620
      y = 20
    }
  }
}
