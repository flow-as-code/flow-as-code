# Generated by @flow-as-code/hcl from doc.flowdoc.json.
# Edits to structure regenerate; comments marked @keep survive.

resource "flowascode_contact_flow" "tasks_and_assistants" {
  instance_id = var.connect_instance_id
  name        = "tasks-and-assistants"
  type        = "CONTACT_FLOW"
  description = "The task and AI agent actions: an AI agents assistant associated by reference and by attribute, a task created from a flow after a delay, from a template, on a schedule and with its flow and delay read from attributes, and a paused task resumed."

  refs = {
    "assistant:agent-help"   = awscc_wisdom_assistant.agent_help.assistant_arn
    "flow:task-line"         = flowascode_contact_flow.task_line.arn
    "tasktemplate:follow-up" = awscc_connect_task_template.follow_up.arn
  }

  action {
    id   = "assist"
    next = "assist-by-attribute"
    create_wisdom_session {
      wisdom_assistant_arn = "assistant:agent-help"
    }
    error {
      type = "NoMatchingError"
      next = "bye"
    }
  }

  action {
    id   = "assist-by-attribute"
    next = "follow-up"
    create_wisdom_session {
      wisdom_assistant_arn = "$.Attributes.assistantArn"
    }
    error {
      type = "NoMatchingError"
      next = "bye"
    }
  }

  action {
    id   = "follow-up"
    next = "templated"
    create_task {
      attributes = {
        customerNumber = "$.CustomerEndpoint.Address"
        reason         = "order"
      }
      contact_flow_id = "flow:task-line"
      delay_seconds   = 3600
      description     = "Call the customer back about their order."
      name            = "Call back"
    }
    error {
      type = "NoMatchingError"
      next = "bye"
    }
  }

  action {
    id   = "templated"
    next = "scheduled"
    create_task {
      name             = "Templated follow up"
      task_template_id = "tasktemplate:follow-up"
    }
    error {
      type = "NoMatchingError"
      next = "bye"
    }
  }

  action {
    id   = "scheduled"
    next = "delayed-by-attribute"
    create_task {
      contact_flow_id  = "flow:task-line"
      name             = "Scheduled follow up"
      scheduled_time   = "$.Attributes.scheduledTaskTime"
      task_template_id = "tasktemplate:follow-up"
    }
    error {
      type = "NoMatchingError"
      next = "bye"
    }
    position {
      x = 20
      y = 220
    }
  }

  action {
    id   = "delayed-by-attribute"
    next = "resume-task"
    create_task {
      contact_flow_id = "$.Attributes.taskFlow"
      delay_seconds   = "$.Attributes.taskDelay"
      name            = "Delayed follow up"
    }
    error {
      type = "NoMatchingError"
      next = "bye"
    }
    position {
      x = 280
      y = 220
    }
  }

  action {
    id   = "resume-task"
    next = "bye"
    resume_contact {}
    error {
      type = "NoMatchingError"
      next = "bye"
    }
    position {
      x = 540
      y = 220
    }
  }

  action {
    id = "bye"
    disconnect_participant {}
    position {
      x = 800
      y = 220
    }
  }
}
