# Edits to structure regenerate; comments marked @keep survive.

resource "flowascode_contact_flow" "contact_state" {
  instance_id = var.connect_instance_id
  name        = "contact-state"
  type        = "CONTACT_FLOW"
  description = "The contact-state actions: the previous participants held and conferenced back, the customer's audio streamed and stopped, chat messages processed and processing stopped, and a paused task resumed."

  refs = {
    "lambda:message-redactor" = aws_lambda_function.message_redactor.arn
  }

  action {
    id   = "hold-agent"
    next = "hold-customer"
    update_previous_contact_participant_state {
      previous_contact_participant_state = "AgentOnHold"
    }
    error {
      type = "NoMatchingError"
      next = "bye"
    }
  }

  action {
    id   = "hold-customer"
    next = "conference"
    update_previous_contact_participant_state {
      previous_contact_participant_state = "CustomerOnHold"
    }
    error {
      type = "NoMatchingError"
      next = "bye"
    }
  }

  action {
    id   = "conference"
    next = "start-stream"
    update_previous_contact_participant_state {
      previous_contact_participant_state = "OffHold"
    }
    error {
      type = "NoMatchingError"
      next = "bye"
    }
  }

  action {
    id   = "start-stream"
    next = "stream-from-customer"
    update_contact_media_streaming_behavior {
      media_stream_type     = "Audio"
      media_streaming_state = "Enabled"
      participants = [
        {
          media_directions = ["From", "To"]
          participant_type = "Customer"
        },
      ]
    }
    error {
      type = "NoMatchingError"
      next = "bye"
    }
  }

  action {
    id   = "stream-from-customer"
    next = "stop-stream"
    update_contact_media_streaming_behavior {
      media_stream_type     = "Audio"
      media_streaming_state = "Enabled"
      participants = [
        {
          media_directions = ["From"]
          participant_type = "Customer"
        },
      ]
    }
    error {
      type = "NoMatchingError"
      next = "bye"
    }
  }

  action {
    id   = "stop-stream"
    next = "process-messages"
    update_contact_media_streaming_behavior {
      media_stream_type     = "Audio"
      media_streaming_state = "Disabled"
      participants = [
        {
          media_directions = ["From", "To"]
          participant_type = "Customer"
        },
      ]
    }
    error {
      type = "NoMatchingError"
      next = "bye"
    }
  }

  action {
    id   = "process-messages"
    next = "process-strictly"
    update_contact_media_processing {
      chat_processor = {
        chat_processor_settings = {
          deliver_unprocessed_messages = "True"
        }
        lambda_processor_arn = "lambda:message-redactor"
        processing_enabled   = "True"
      }
    }
    error {
      type = "NoMatchingError"
      next = "bye"
    }
    error {
      type = "ChannelMismatch"
      next = "process-strictly"
    }
  }

  action {
    id   = "process-strictly"
    next = "stop-processing"
    update_contact_media_processing {
      chat_processor = {
        chat_processor_settings = {
          deliver_unprocessed_messages = "False"
        }
        lambda_processor_arn = "lambda:message-redactor"
        processing_enabled   = "True"
      }
    }
    error {
      type = "NoMatchingError"
      next = "bye"
    }
    error {
      type = "ChannelMismatch"
      next = "stop-processing"
    }
  }

  action {
    id   = "stop-processing"
    next = "resume-task"
    update_contact_media_processing {
      chat_processor = {
        processing_enabled = "False"
      }
    }
    error {
      type = "NoMatchingError"
      next = "bye"
    }
    error {
      type = "ChannelMismatch"
      next = "resume-task"
    }
  }

  action {
    id   = "resume-task"
    next = "bye"
    resume_contact {}
    error {
      type = "NoMatchingError"
      next = "bye"
    }
  }

  action {
    id = "bye"
    disconnect_participant {}
  }
}
