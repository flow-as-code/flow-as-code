# Generated by @flow-as-code/hcl from doc.flowdoc.json.
# Edits to structure regenerate; comments marked @keep survive.

resource "flowascode_contact_flow" "customer_profiles" {
  instance_id = var.connect_instance_id
  name        = "customer-profiles"
  type        = "CONTACT_FLOW"
  description = "The Customer Profiles actions: the caller looked up by one identifier, then by two search criteria joined by AND when several match, a profile created when none is found, the contact associated with the profile, and a custom attribute and an email address updated."

  action {
    id   = "find-caller"
    next = "link-contact"
    get_customer_profile {
      profile_request_data = {
        identifier_name  = "_phone"
        identifier_value = "$.CustomerEndpoint.Address"
      }
      profile_response_data = ["FirstName", "LastName", "Attributes.loyaltyTier"]
    }
    error {
      type = "NoMatchingError"
      next = "bye"
    }
    error {
      type = "MultipleFoundError"
      next = "find-by-account"
    }
    error {
      type = "NoneFoundError"
      next = "create-profile"
    }
  }

  action {
    id   = "find-by-account"
    next = "link-contact"
    get_customer_profile {
      profile_request_data = {
        logical_operator = "AND"
        search_criteria = [
          {
            identifier_name  = "_phone"
            identifier_value = "$.CustomerEndpoint.Address"
          },
          {
            identifier_name  = "_account"
            identifier_value = "$.Attributes.accountNumber"
          },
        ]
      }
      profile_response_data = ["AccountNumber", "FirstName"]
    }
    error {
      type = "NoMatchingError"
      next = "bye"
    }
    error {
      type = "MultipleFoundError"
      next = "bye"
    }
    error {
      type = "NoneFoundError"
      next = "create-profile"
    }
  }

  action {
    id   = "create-profile"
    next = "link-contact"
    create_customer_profile {
      profile_request_data = {
        "Attributes.loyaltyTier" = "new"
        FirstName                = "$.Attributes.firstName"
        PhoneNumber              = "$.CustomerEndpoint.Address"
      }
      profile_response_data = ["FirstName", "Attributes.loyaltyTier"]
    }
    error {
      type = "NoMatchingError"
      next = "bye"
    }
  }

  action {
    id   = "link-contact"
    next = "update-profile"
    associate_contact_to_customer_profile {
      profile_request_data = {
        contact_id = "$.ContactId"
        profile_id = "$.Customer.ProfileId"
      }
      profile_response_data = []
    }
    error {
      type = "NoMatchingError"
      next = "bye"
    }
  }

  action {
    id   = "update-profile"
    next = "bye"
    update_customer_profile {
      profile_request_data = {
        "Attributes.preferredLanguage" = "$.Attributes.language"
        EmailAddress                   = "$.Attributes.email"
      }
      profile_response_data = ["Attributes.preferredLanguage"]
    }
    error {
      type = "NoMatchingError"
      next = "bye"
    }
  }

  action {
    id = "bye"
    disconnect_participant {}
  }
}
