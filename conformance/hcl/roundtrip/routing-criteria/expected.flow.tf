    error {
      type = "NoMatchingError"
      next = "by-proficiency"
    }
  }

  action {
    id   = "by-proficiency"
    next = "transfer"
    update_routing_criteria {
      routing_criteria = {
        steps = [
          {
            expiry = {
              duration_in_seconds = 30
            }
            expression = jsonencode({
              OrExpression = [
                {
                  AndExpression = [
                    {
                      AttributeCondition = {
                        ComparisonOperator = "NumberGreaterOrEqualTo"
                        Name               = "Language"
                        ProficiencyLevel   = 4
                        Value              = "English"
                      }
                    },
                    {
                      AttributeCondition = {
                        ComparisonOperator = "NumberGreaterOrEqualTo"
                        Name               = "Technology"
                        ProficiencyLevel   = 2
                        Value              = "AWS Kinesis"
                      }
                    },
                  ]
                },
                {
                  AttributeCondition = {
                    ComparisonOperator = "NumberGreaterOrEqualTo"
                    Name               = "Language"
                    ProficiencyLevel   = 5
                    Value              = "Spanish"
                  }
                },
              ]
            })
          },
          {
            expiry = {
              duration_in_seconds = 60
            }
            expression = jsonencode({
              AndExpression = [
                {
                  AttributeCondition = {
                    ComparisonOperator = "NumberGreaterOrEqualTo"
                    Name               = "Language"
                    ProficiencyLevel   = 3
                    Value              = "English"
                  }
                },
                {
                  AttributeCondition = {
                    ComparisonOperator = "NumberGreaterOrEqualTo"
                    Name               = "Technology"
                    ProficiencyLevel   = 1
                    Value              = "AWS Kinesis"
                  }
                },
              ]
            })
          },
          {
            expression = jsonencode({
              AttributeCondition = {
                ComparisonOperator = "NumberGreaterOrEqualTo"
                Name               = "Language"
                ProficiencyLevel   = 1
                Value              = "$.Attributes.language"
              }
            })
          },
        ]
      }
    }
    error {
