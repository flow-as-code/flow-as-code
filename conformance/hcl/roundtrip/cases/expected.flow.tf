# Generated by @flow-as-code/hcl from doc.flowdoc.json.
# Edits to structure regenerate; comments marked @keep survive.

resource "flowascode_contact_flow" "cases" {
  instance_id = var.connect_instance_id
  name        = "cases"
  type        = "CONTACT_FLOW"
  description = "The Cases actions: the caller's open cases searched by customer and status, linking the contact and storing three fields, the last updated case read by customer id when several match, the case found updated with a domain field by reference and its summary, linking the current contact, and when none is found a case opened from a template with a domain field by reference and three system fields, linking the current contact, then a call log case opened without linking."

  refs = {
    "casefield:channel"            = awscc_connectcases_field.channel.field_id
    "casefield:priority"           = awscc_connectcases_field.priority.field_id
    "casetemplate:billing-dispute" = awscc_connectcases_template.billing_dispute.template_id
    "casetemplate:call-log"        = awscc_connectcases_template.call_log.template_id
  }

  action {
    id   = "find-case"
    next = "update-case"
    get_case {
      case_request_fields = {
        customer_id = "$.Customer.ProfileARN"
        status      = "open"
      }
      case_response_fields  = ["case_id", "status", "casefield:priority"]
      get_last_updated_case = "false"
      link_contact_to_case  = "true"
    }
    error {
      type = "ContactNotLinked"
      next = "update-case"
    }
    error {
      type = "MultipleFound"
      next = "find-latest"
    }
    error {
      type = "NoneFound"
      next = "open-case"
    }
    error {
      type = "NoMatchingError"
      next = "bye"
    }
  }

  action {
    id   = "find-latest"
    next = "update-case"
    get_case {
      case_response_fields  = ["case_id"]
      customer_id           = "$.Customer.ProfileARN"
      get_last_updated_case = "true"
      link_contact_to_case  = "false"
    }
    error {
      type = "MultipleFound"
      next = "bye"
    }
    error {
      type = "NoneFound"
      next = "open-case"
    }
    error {
      type = "NoMatchingError"
      next = "bye"
    }
  }

  action {
    id   = "update-case"
    next = "bye"
    update_case {
      case_id = "$.Case.case_id"
      case_request_fields = {
        "casefield:priority" = "high"
        summary              = "Called again: $.Attributes.reason"
      }
      contact_to_link      = "Current"
      link_contact_to_case = "true"
    }
    error {
      type = "ContactNotLinked"
      next = "bye"
    }
    error {
      type = "NoMatchingError"
      next = "bye"
    }
  }

  action {
    id   = "open-case"
    next = "log-case"
    create_case {
      case_request_fields = {
        "casefield:priority" = "high"
        customer_id          = "$.Customer.ProfileARN"
        summary              = "$.Attributes.summary"
        title                = "Billing dispute"
      }
      case_template_id     = "casetemplate:billing-dispute"
      contact_to_link      = "Current"
      link_contact_to_case = "true"
    }
    error {
      type = "ContactNotLinked"
      next = "log-case"
    }
    error {
      type = "NoMatchingError"
      next = "bye"
    }
  }

  action {
    id   = "log-case"
    next = "bye"
    create_case {
      case_request_fields = {
        "casefield:channel" = "$.Channel"
        status              = "open"
      }
      case_template_id     = "casetemplate:call-log"
      link_contact_to_case = "false"
    }
    error {
      type = "NoMatchingError"
      next = "bye"
    }
  }

  action {
    id = "bye"
    disconnect_participant {}
  }
}
