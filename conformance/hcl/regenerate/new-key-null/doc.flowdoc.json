{
  "flowdoc": "0.2",
  "kind": "flow",
  "name": "regen-sample",
  "connectType": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "welcome",
    "Actions": [
      {
        "Identifier": "welcome",
        "Type": "MessageParticipant",
        "Parameters": {
          "Text": "Welcome."
        },
        "Transitions": {
          "NextAction": "look-up",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "hang-up"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "look-up",
        "Type": "InvokeLambdaFunction",
        "Parameters": {
          "InvocationTimeLimitSeconds": 8,
          "InvocationType": "SYNCHRONOUS",
          "LambdaFunctionARN": "${cdref:lambda:lookup}"
        },
        "Transitions": {
          "NextAction": "set-queue",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "hang-up"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "set-queue",
        "Type": "UpdateContactTargetQueue",
        "Parameters": {
          "QueueId": "${cdref:queue:appointments}"
        },
        "Transitions": {
          "NextAction": "hang-up",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "hang-up"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "hang-up",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  },
  "layout": {
    "hang-up": {
      "x": 800,
      "y": 20
    },
    "look-up": {
      "x": 280,
      "y": 20
    },
    "set-queue": {
      "x": 540,
      "y": 20
    },
    "welcome": {
      "x": 20,
      "y": 20
    }
  },
  "refs": [
    {
      "token": "${cdref:lambda:lookup}",
      "type": "lambda",
      "name": "lookup"
    },
    {
      "token": "${cdref:queue:appointments}",
      "type": "queue",
      "name": "appointments"
    }
  ]
}
