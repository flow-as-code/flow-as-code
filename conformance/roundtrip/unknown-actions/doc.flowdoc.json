{
  "flowdoc": "0.3",
  "kind": "flow",
  "name": "unknown-actions",
  "connectType": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "create-task",
    "Actions": [
      {
        "Identifier": "create-task",
        "Type": "CreateTask",
        "Parameters": {
          "Attributes": {
            "CustomerPhoneNumber": "$.CustomerEndpoint.Address",
            "queue": "${cdref:queue:support}"
          },
          "ContactFlowId": "${cdref:flow:task-flow}",
          "Description": "A task for the agent, with the customer's number.",
          "Name": "Follow up"
        },
        "Transitions": {
          "NextAction": "load-content",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "hand-off"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "load-content",
        "Type": "LoadContactContent",
        "Parameters": {
          "ContentType": "EmailMessage"
        },
        "Transitions": {
          "NextAction": "transfer-third-party",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "hand-off"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "transfer-third-party",
        "Type": "TransferParticipantToThirdParty",
        "Parameters": {
          "ContinueFlowExecution": "True",
          "ThirdPartyConnectionTimeLimitSeconds": "30",
          "ThirdPartyPhoneNumber": "$.Attributes.deskPhone"
        },
        "Transitions": {
          "NextAction": "hand-off",
          "Errors": [
            {
              "ErrorType": "CallFailed",
              "NextAction": "hand-off"
            },
            {
              "ErrorType": "ConnectionTimeLimitExceeded",
              "NextAction": "hand-off"
            },
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "hand-off"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "hand-off",
        "Type": "StartVoiceIdStream",
        "Parameters": {},
        "Transitions": {
          "NextAction": "load-content",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "load-content"
            }
          ],
          "Conditions": []
        }
      }
    ]
  },
  "layout": {
    "create-task": {
      "x": 20,
      "y": 20
    },
    "hand-off": {
      "x": 800,
      "y": 20
    },
    "load-content": {
      "x": 280,
      "y": 20
    },
    "transfer-third-party": {
      "x": 540,
      "y": 20
    }
  },
  "refs": [
    {
      "token": "${cdref:flow:task-flow}",
      "type": "flow",
      "name": "task-flow"
    },
    {
      "token": "${cdref:queue:support}",
      "type": "queue",
      "name": "support"
    }
  ]
}
