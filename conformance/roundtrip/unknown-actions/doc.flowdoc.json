{
  "flowdoc": "0.3",
  "kind": "flow",
  "name": "unknown-actions",
  "connectType": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "text-back",
    "Actions": [
      {
        "Identifier": "text-back",
        "Type": "StartOutboundChatContact",
        "Parameters": {
          "ContactFlowArn": "${cdref:flow:task-flow}",
          "ContactSubtype": "connect:SMS",
          "DestinationEndpoint": {
            "Address": "$.CustomerEndpoint.Address",
            "Type": "TELEPHONE_NUMBER"
          },
          "SourceEndpoint": {
            "Address": "$.Attributes.smsNumberArn",
            "Type": "CONNECT_PHONENUMBER_ARN"
          }
        },
        "Transitions": {
          "NextAction": "route-to-queue",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "hand-off"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "route-to-queue",
        "Type": "UpdateRoutingCriteria",
        "Parameters": {
          "RoutingCriteria": {
            "Steps": [
              {
                "Expression": {
                  "AttributeCondition": {
                    "Name": "preferredQueue",
                    "Value": "${cdref:queue:support}"
                  }
                }
              }
            ]
          }
        },
        "Transitions": {
          "NextAction": "load-content",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "hand-off"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "load-content",
        "Type": "LoadContactContent",
        "Parameters": {
          "ContentType": "EmailMessage"
        },
        "Transitions": {
          "NextAction": "transfer-third-party",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "hand-off"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "transfer-third-party",
        "Type": "TransferParticipantToThirdParty",
        "Parameters": {
          "ContinueFlowExecution": "True",
          "ThirdPartyConnectionTimeLimitSeconds": "30",
          "ThirdPartyPhoneNumber": "$.Attributes.deskPhone"
        },
        "Transitions": {
          "NextAction": "hand-off",
          "Errors": [
            {
              "ErrorType": "CallFailed",
              "NextAction": "hand-off"
            },
            {
              "ErrorType": "ConnectionTimeLimitExceeded",
              "NextAction": "hand-off"
            },
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "hand-off"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "hand-off",
        "Type": "StartVoiceIdStream",
        "Parameters": {},
        "Transitions": {
          "NextAction": "load-content",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "load-content"
            }
          ],
          "Conditions": []
        }
      }
    ]
  },
  "layout": {
    "hand-off": {
      "x": 1060,
      "y": 20
    },
    "load-content": {
      "x": 540,
      "y": 20
    },
    "route-to-queue": {
      "x": 280,
      "y": 20
    },
    "text-back": {
      "x": 20,
      "y": 20
    },
    "transfer-third-party": {
      "x": 800,
      "y": 20
    }
  },
  "refs": [
    {
      "token": "${cdref:flow:task-flow}",
      "type": "flow",
      "name": "task-flow"
    },
    {
      "token": "${cdref:queue:support}",
      "type": "queue",
      "name": "support"
    }
  ]
}
