{
  "flowdoc": "0.3",
  "kind": "flow",
  "name": "contact-state",
  "description": "The contact-state actions: a paused task resumed.",
  "connectType": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "resume-task",
    "Actions": [
      {
        "Identifier": "resume-task",
        "Type": "ResumeContact",
        "Parameters": {},
        "Transitions": {
          "NextAction": "bye",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "bye"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "bye",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  },
  "layout": {
    "bye": {
      "x": 280,
      "y": 20
    },
    "resume-task": {
      "x": 20,
      "y": 20
    }
  },
  "refs": []
}
