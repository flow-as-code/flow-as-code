{
  "flowdoc": "0.1",
  "kind": "flow",
  "name": "repeated-key",
  "connectType": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "menu",
    "Actions": [
      {
        "Identifier": "menu",
        "Type": "GetParticipantInput",
        "Parameters": {
          "InputTimeLimitSeconds": "5",
          "StoreInput": "False",
          "Text": "For sales, press 1. For support, press 2."
        },
        "Transitions": {
          "NextAction": "no-match",
          "Errors": [
            {
              "ErrorType": "InputTimeLimitExceeded",
              "NextAction": "no-match"
            },
            {
              "ErrorType": "NoMatchingCondition",
              "NextAction": "no-match"
            },
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "bye"
            }
          ],
          "Conditions": [
            {
              "NextAction": "sales",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "1"
                ]
              }
            },
            {
              "NextAction": "support",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "1"
                ]
              }
            },
            {
              "NextAction": "menu",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "*"
                ]
              }
            }
          ]
        }
      },
      {
        "Identifier": "no-match",
        "Type": "MessageParticipant",
        "Parameters": {
          "Text": "That is not a valid option."
        },
        "Transitions": {
          "NextAction": "menu",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "bye"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "sales",
        "Type": "MessageParticipant",
        "Parameters": {
          "Text": "Connecting you to sales."
        },
        "Transitions": {
          "NextAction": "bye",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "bye"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "support",
        "Type": "MessageParticipant",
        "Parameters": {
          "Text": "Connecting you to support."
        },
        "Transitions": {
          "NextAction": "bye",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "bye"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "bye",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  },
  "layout": {
    "bye": {
      "x": 560,
      "y": 120
    },
    "menu": {
      "x": 0,
      "y": 120
    },
    "no-match": {
      "x": 280,
      "y": 0
    },
    "sales": {
      "x": 280,
      "y": 120
    },
    "support": {
      "x": 280,
      "y": 240
    }
  },
  "refs": []
}
