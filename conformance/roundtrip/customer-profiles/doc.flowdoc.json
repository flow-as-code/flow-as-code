{
  "flowdoc": "0.3",
  "kind": "flow",
  "name": "customer-profiles",
  "description": "The Customer Profiles actions: the caller looked up by one identifier, then by two search criteria joined by AND when several match, a profile created when none is found, the contact associated with the profile, an email address updated and a custom attribute read back, the latest order and an asset by its identifier read, and a predefined and a custom calculated attribute read.",
  "connectType": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "find-caller",
    "Actions": [
      {
        "Identifier": "find-caller",
        "Type": "GetCustomerProfile",
        "Parameters": {
          "ProfileRequestData": {
            "IdentifierName": "_phone",
            "IdentifierValue": "$.CustomerEndpoint.Address"
          },
          "ProfileResponseData": [
            "FirstName",
            "LastName",
            "Attributes.loyaltyTier"
          ]
        },
        "Transitions": {
          "NextAction": "link-contact",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "bye"
            },
            {
              "ErrorType": "MultipleFoundError",
              "NextAction": "find-by-account"
            },
            {
              "ErrorType": "NoneFoundError",
              "NextAction": "create-profile"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "find-by-account",
        "Type": "GetCustomerProfile",
        "Parameters": {
          "ProfileRequestData": {
            "LogicalOperator": "AND",
            "SearchCriteria": [
              {
                "IdentifierName": "_phone",
                "IdentifierValue": "$.CustomerEndpoint.Address"
              },
              {
                "IdentifierName": "_account",
                "IdentifierValue": "$.Attributes.accountNumber"
              }
            ]
          },
          "ProfileResponseData": [
            "AccountNumber",
            "FirstName"
          ]
        },
        "Transitions": {
          "NextAction": "link-contact",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "bye"
            },
            {
              "ErrorType": "MultipleFoundError",
              "NextAction": "bye"
            },
            {
              "ErrorType": "NoneFoundError",
              "NextAction": "create-profile"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "create-profile",
        "Type": "CreateCustomerProfile",
        "Parameters": {
          "ProfileRequestData": {
            "FirstName": "$.Attributes.firstName",
            "PhoneNumber": "$.CustomerEndpoint.Address"
          },
          "ProfileResponseData": [
            "FirstName",
            "Attributes.loyaltyTier"
          ]
        },
        "Transitions": {
          "NextAction": "link-contact",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "bye"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "link-contact",
        "Type": "AssociateContactToCustomerProfile",
        "Parameters": {
          "ProfileRequestData": {
            "ContactId": "$.ContactId",
            "ProfileId": "$.Customer.ProfileId"
          }
        },
        "Transitions": {
          "NextAction": "update-profile",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "bye"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "update-profile",
        "Type": "UpdateCustomerProfile",
        "Parameters": {
          "ProfileRequestData": {
            "EmailAddress": "$.Attributes.email"
          },
          "ProfileResponseData": [
            "Attributes.preferredLanguage"
          ]
        },
        "Transitions": {
          "NextAction": "latest-order",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "bye"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "latest-order",
        "Type": "GetCustomerProfileObject",
        "Parameters": {
          "ProfileRequestData": {
            "ObjectType": "Order",
            "ProfileId": "$.Customer.ProfileId",
            "UseLatest": "true"
          },
          "ProfileResponseData": [
            "OrderStatus",
            "OrderTotalPrice",
            "OrderAttributes.giftWrap"
          ]
        },
        "Transitions": {
          "NextAction": "asset-by-id",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "bye"
            },
            {
              "ErrorType": "NoneFoundError",
              "NextAction": "asset-by-id"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "asset-by-id",
        "Type": "GetCustomerProfileObject",
        "Parameters": {
          "ProfileRequestData": {
            "IdentifierName": "_assetId",
            "IdentifierValue": "$.Attributes.assetId",
            "ObjectType": "Asset",
            "ProfileId": "$.Customer.ProfileId"
          },
          "ProfileResponseData": [
            "AssetPrice",
            "AssetPurchaseDate"
          ]
        },
        "Transitions": {
          "NextAction": "calculated",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "bye"
            },
            {
              "ErrorType": "NoneFoundError",
              "NextAction": "calculated"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "calculated",
        "Type": "GetCalculatedAttributesForCustomerProfile",
        "Parameters": {
          "ProfileRequestData": {
            "ProfileId": "$.Customer.ProfileId"
          },
          "ProfileResponseData": [
            "CalculatedAttributes._frequent_caller",
            "CalculatedAttributes.lifetimeValue"
          ]
        },
        "Transitions": {
          "NextAction": "bye",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "bye"
            },
            {
              "ErrorType": "NoneFoundError",
              "NextAction": "bye"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "bye",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  },
  "layout": {
    "asset-by-id": {
      "x": 1580,
      "y": 20
    },
    "bye": {
      "x": 2100,
      "y": 20
    },
    "calculated": {
      "x": 1840,
      "y": 20
    },
    "create-profile": {
      "x": 540,
      "y": 20
    },
    "find-by-account": {
      "x": 280,
      "y": 20
    },
    "find-caller": {
      "x": 20,
      "y": 20
    },
    "latest-order": {
      "x": 1320,
      "y": 20
    },
    "link-contact": {
      "x": 800,
      "y": 20
    },
    "update-profile": {
      "x": 1060,
      "y": 20
    }
  },
  "refs": []
}
