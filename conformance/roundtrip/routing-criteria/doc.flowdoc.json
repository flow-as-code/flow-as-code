{
  "flowdoc": "0.3",
  "kind": "flow",
  "name": "routing-criteria",
  "description": "Routing criteria set on a contact before its transfer to queue: the whole criteria read from a Lambda's response by a JSONPath and, when that fails, three typed steps, an AND of two requirements, another AND of two, and a requirement whose value is read from an attribute, the last never expiring.",
  "connectType": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "set-queue",
    "Actions": [
      {
        "Identifier": "set-queue",
        "Type": "UpdateContactTargetQueue",
        "Parameters": {
          "QueueId": "$.Attributes.queueId"
        },
        "Transitions": {
          "NextAction": "from-lambda",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "bye"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "from-lambda",
        "Type": "UpdateContactRoutingCriteria",
        "Parameters": {
          "RoutingCriteria": "$.External.RoutingCriteria"
        },
        "Transitions": {
          "NextAction": "transfer",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "by-proficiency"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "by-proficiency",
        "Type": "UpdateContactRoutingCriteria",
        "Parameters": {
          "RoutingCriteria": {
            "Steps": [
              {
                "Expiry": {
                  "DurationInSeconds": "30"
                },
                "Expression": {
                  "AndExpression": [
                    {
                      "AttributeCondition": {
                        "ComparisonOperator": "NumberGreaterOrEqualTo",
                        "Name": "Language",
                        "ProficiencyLevel": 4,
                        "Value": "English"
                      }
                    },
                    {
                      "AttributeCondition": {
                        "ComparisonOperator": "NumberGreaterOrEqualTo",
                        "Name": "Technology",
                        "ProficiencyLevel": 2,
                        "Value": "AWS Kinesis"
                      }
                    }
                  ]
                }
              },
              {
                "Expiry": {
                  "DurationInSeconds": "60"
                },
                "Expression": {
                  "AndExpression": [
                    {
                      "AttributeCondition": {
                        "ComparisonOperator": "NumberGreaterOrEqualTo",
                        "Name": "Language",
                        "ProficiencyLevel": 3,
                        "Value": "English"
                      }
                    },
                    {
                      "AttributeCondition": {
                        "ComparisonOperator": "NumberGreaterOrEqualTo",
                        "Name": "Technology",
                        "ProficiencyLevel": 1,
                        "Value": "AWS Kinesis"
                      }
                    }
                  ]
                }
              },
              {
                "Expression": {
                  "AttributeCondition": {
                    "ComparisonOperator": "NumberGreaterOrEqualTo",
                    "Name": "Language",
                    "ProficiencyLevel": 1,
                    "Value": "$.Attributes.language"
                  }
                }
              }
            ]
          }
        },
        "Transitions": {
          "NextAction": "transfer",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "bye"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "transfer",
        "Type": "TransferContactToQueue",
        "Parameters": {},
        "Transitions": {
          "NextAction": "bye",
          "Errors": [
            {
              "ErrorType": "QueueAtCapacity",
              "NextAction": "bye"
            },
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "bye"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "bye",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  },
  "layout": {
    "by-proficiency": {
      "x": 540,
      "y": 20
    },
    "bye": {
      "x": 1060,
      "y": 20
    },
    "from-lambda": {
      "x": 280,
      "y": 20
    },
    "set-queue": {
      "x": 20,
      "y": 20
    },
    "transfer": {
      "x": 800,
      "y": 20
    }
  },
  "refs": []
}
