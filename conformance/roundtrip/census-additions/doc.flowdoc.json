{
  "flowdoc": "0.3",
  "kind": "flow",
  "name": "census-additions",
  "description": "The Types no Developer Guide category page lists (tasks/D09): a transfer to a desk phone that resumes the flow when the third party hangs up, a transfer to an on-call number that ends it, and an email message body loaded for a later branch.",
  "connectType": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "transfer-desk",
    "Actions": [
      {
        "Identifier": "transfer-desk",
        "Type": "TransferParticipantToThirdParty",
        "Parameters": {
          "ContinueFlowExecution": "True",
          "ThirdPartyConnectionTimeLimitSeconds": "30",
          "ThirdPartyPhoneNumber": "$.Attributes.deskPhone"
        },
        "Transitions": {
          "NextAction": "load-email",
          "Errors": [
            {
              "ErrorType": "CallFailed",
              "NextAction": "transfer-on-call"
            },
            {
              "ErrorType": "ConnectionTimeLimitExceeded",
              "NextAction": "transfer-on-call"
            },
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "bye"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "transfer-on-call",
        "Type": "TransferParticipantToThirdParty",
        "Parameters": {
          "ContinueFlowExecution": "False",
          "ThirdPartyConnectionTimeLimitSeconds": "45",
          "ThirdPartyPhoneNumber": "$.Attributes.onCallPhone"
        },
        "Transitions": {
          "NextAction": "load-email",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "load-email"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "load-email",
        "Type": "LoadContactContent",
        "Parameters": {
          "ContentType": "EmailMessage"
        },
        "Transitions": {
          "NextAction": "bye",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "bye"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "bye",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  },
  "layout": {
    "bye": {
      "x": 800,
      "y": 20
    },
    "load-email": {
      "x": 540,
      "y": 20
    },
    "transfer-desk": {
      "x": 20,
      "y": 20
    },
    "transfer-on-call": {
      "x": 280,
      "y": 20
    }
  },
  "refs": []
}
