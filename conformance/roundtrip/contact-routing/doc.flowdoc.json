{
  "flowdoc": "0.2",
  "kind": "module",
  "name": "contact-routing",
  "description": "Queue-to-queue transfer with an overflow path.",
  "connectType": "MODULE",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "move-to-priority-queue",
    "Settings": {},
    "Actions": [
      {
        "Identifier": "move-to-priority-queue",
        "Type": "DequeueContactAndTransferToQueue",
        "Parameters": {
          "QueueId": "${cdref:queue:priority}"
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "QueueAtCapacity",
              "NextAction": "try-agent-queue"
            },
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "apologize"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "try-agent-queue",
        "Type": "DequeueContactAndTransferToQueue",
        "Parameters": {
          "AgentId": "$.Attributes.preferredAgentArn"
        },
        "Transitions": {
          "NextAction": "hand-to-agent",
          "Errors": [
            {
              "ErrorType": "QueueAtCapacity",
              "NextAction": "stay-in-queue"
            },
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "apologize"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "stay-in-queue",
        "Type": "DequeueContactAndTransferToQueue",
        "Parameters": {},
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "QueueAtCapacity",
              "NextAction": "apologize"
            },
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "apologize"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "apologize",
        "Type": "MessageParticipant",
        "Parameters": {
          "Text": "We could not move you to another queue. Please hold."
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "hand-to-agent",
        "Type": "TransferContactToAgent",
        "Parameters": {},
        "Transitions": {}
      },
      {
        "Identifier": "done",
        "Type": "EndFlowModuleExecution",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  },
  "layout": {
    "apologize": {
      "x": 800,
      "y": 20
    },
    "done": {
      "x": 1060,
      "y": 20
    },
    "hand-to-agent": {
      "x": 540,
      "y": 20
    },
    "move-to-priority-queue": {
      "x": 20,
      "y": 20
    },
    "stay-in-queue": {
      "x": 540,
      "y": 120
    },
    "try-agent-queue": {
      "x": 280,
      "y": 20
    }
  },
  "refs": [
    {
      "token": "${cdref:queue:priority}",
      "type": "queue",
      "name": "priority"
    }
  ]
}
