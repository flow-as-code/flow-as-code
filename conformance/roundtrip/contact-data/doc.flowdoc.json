{
  "flowdoc": "0.2",
  "kind": "flow",
  "name": "contact-data",
  "description": "Contact-data actions: tags, voice, data and event hooks.",
  "connectType": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "tag",
    "Actions": [
      {
        "Identifier": "tag",
        "Type": "TagContact",
        "Parameters": {
          "Tags": {
            "team": "cx",
            "tier": "$.Attributes.tier"
          }
        },
        "Transitions": {
          "NextAction": "untag",
          "Errors": [],
          "Conditions": []
        }
      },
      {
        "Identifier": "untag",
        "Type": "UnTagContact",
        "Parameters": {
          "TagKeys": [
            "tier"
          ]
        },
        "Transitions": {
          "NextAction": "greet",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "bye"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "greet",
        "Type": "MessageParticipant",
        "Parameters": {
          "Text": "Thanks for calling."
        },
        "Transitions": {
          "NextAction": "bye",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "bye"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "bye",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  },
  "layout": {
    "bye": {
      "x": 800,
      "y": 20
    },
    "greet": {
      "x": 540,
      "y": 20
    },
    "tag": {
      "x": 20,
      "y": 20
    },
    "untag": {
      "x": 280,
      "y": 20
    }
  },
  "refs": []
}
