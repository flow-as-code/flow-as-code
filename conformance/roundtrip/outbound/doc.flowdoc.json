{
  "flowdoc": "0.3",
  "kind": "flow",
  "name": "outbound",
  "description": "The outbound actions in an outbound whisper flow: the call placed with a static caller ID, or through a Chime voice connector read from attributes (a form that stays generic, owner decision 4), then the call's progress checked on all four statuses, a person answering greeted, either voicemail result noted, and no detection ending the whisper.",
  "connectType": "OUTBOUND_WHISPER",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "choose-route",
    "Actions": [
      {
        "Identifier": "choose-route",
        "Type": "Compare",
        "Parameters": {
          "ComparisonValue": "$.Attributes.route"
        },
        "Transitions": {
          "NextAction": "place-call",
          "Errors": [
            {
              "ErrorType": "NoMatchingCondition",
              "NextAction": "place-call"
            }
          ],
          "Conditions": [
            {
              "NextAction": "place-call-via-sip",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "sip"
                ]
              }
            }
          ]
        }
      },
      {
        "Identifier": "place-call",
        "Type": "CompleteOutboundCall",
        "Parameters": {
          "CallerId": {
            "Number": "+15555550100"
          }
        },
        "Transitions": {
          "NextAction": "check-progress",
          "Errors": [],
          "Conditions": []
        }
      },
      {
        "Identifier": "place-call-via-sip",
        "Type": "CompleteOutboundCall",
        "Parameters": {
          "ConnectionTimeLimitSeconds": "30",
          "VoiceConnector": {
            "FromUser": "$.Attributes.fromUser",
            "ToUser": "$.CustomerEndpoint.Address",
            "VoiceConnectorArn": "$.Attributes.voiceConnectorArn",
            "VoiceConnectorType": "ChimeConnector"
          }
        },
        "Transitions": {
          "NextAction": "check-progress",
          "Errors": [],
          "Conditions": []
        }
      },
      {
        "Identifier": "check-progress",
        "Type": "CheckOutboundCallStatus",
        "Parameters": {},
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": [
            {
              "NextAction": "greet",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "CallAnswered"
                ]
              }
            },
            {
              "NextAction": "leave-message",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "VoicemailBeep"
                ]
              }
            },
            {
              "NextAction": "leave-message",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "VoicemailNoBeep"
                ]
              }
            },
            {
              "NextAction": "done",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "NotDetected"
                ]
              }
            }
          ]
        }
      },
      {
        "Identifier": "greet",
        "Type": "MessageParticipant",
        "Parameters": {
          "Text": "Connecting you to the customer."
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [],
          "Conditions": []
        }
      },
      {
        "Identifier": "leave-message",
        "Type": "MessageParticipant",
        "Parameters": {
          "Text": "The call reached voicemail."
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "EndFlowExecution",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  },
  "layout": {
    "check-progress": {
      "x": 540,
      "y": 20
    },
    "choose-route": {
      "x": 20,
      "y": 20
    },
    "done": {
      "x": 1060,
      "y": 20
    },
    "greet": {
      "x": 800,
      "y": 20
    },
    "leave-message": {
      "x": 800,
      "y": 180
    },
    "place-call": {
      "x": 280,
      "y": 20
    },
    "place-call-via-sip": {
      "x": 280,
      "y": 180
    }
  },
  "refs": []
}
