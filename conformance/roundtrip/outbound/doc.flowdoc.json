{
  "flowdoc": "0.3",
  "kind": "flow",
  "name": "outbound",
  "description": "The outbound actions in an outbound whisper flow: the call placed with a static caller ID, or through a Chime voice connector (generic, owner decision 4); its progress checked on all four statuses; a person greeted; on voicemail an SMS from the claimed number and flow by reference, with a message, linked to the contact; and with no detection an SMS from a number and flow read from attributes.",
  "connectType": "OUTBOUND_WHISPER",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "choose-route",
    "Actions": [
      {
        "Identifier": "choose-route",
        "Type": "Compare",
        "Parameters": {
          "ComparisonValue": "$.Attributes.route"
        },
        "Transitions": {
          "NextAction": "place-call",
          "Errors": [
            {
              "ErrorType": "NoMatchingCondition",
              "NextAction": "place-call"
            }
          ],
          "Conditions": [
            {
              "NextAction": "place-call-via-sip",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "sip"
                ]
              }
            }
          ]
        }
      },
      {
        "Identifier": "place-call",
        "Type": "CompleteOutboundCall",
        "Parameters": {
          "CallerId": {
            "Number": "+15555550100"
          }
        },
        "Transitions": {
          "NextAction": "check-progress",
          "Errors": [],
          "Conditions": []
        }
      },
      {
        "Identifier": "place-call-via-sip",
        "Type": "CompleteOutboundCall",
        "Parameters": {
          "ConnectionTimeLimitSeconds": "30",
          "VoiceConnector": {
            "FromUser": "$.Attributes.fromUser",
            "ToUser": "$.CustomerEndpoint.Address",
            "VoiceConnectorArn": "$.Attributes.voiceConnectorArn",
            "VoiceConnectorType": "ChimeConnector"
          }
        },
        "Transitions": {
          "NextAction": "check-progress",
          "Errors": [],
          "Conditions": []
        }
      },
      {
        "Identifier": "check-progress",
        "Type": "CheckOutboundCallStatus",
        "Parameters": {},
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": [
            {
              "NextAction": "greet",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "CallAnswered"
                ]
              }
            },
            {
              "NextAction": "text-back",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "VoicemailBeep"
                ]
              }
            },
            {
              "NextAction": "text-back",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "VoicemailNoBeep"
                ]
              }
            },
            {
              "NextAction": "text-from-attributes",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "NotDetected"
                ]
              }
            }
          ]
        }
      },
      {
        "Identifier": "greet",
        "Type": "MessageParticipant",
        "Parameters": {
          "Text": "Connecting you to the customer."
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [],
          "Conditions": []
        }
      },
      {
        "Identifier": "text-back",
        "Type": "StartOutboundChatContact",
        "Parameters": {
          "ContactFlowArn": "${cdref:flow:sms-follow-up}",
          "ContactSubtype": "connect:SMS",
          "DestinationEndpoint": {
            "Address": "$.CustomerEndpoint.Address",
            "Type": "TELEPHONE_NUMBER"
          },
          "InitialSystemMessage": {
            "Content": "We tried to call you. Reply here to pick up where we left off."
          },
          "RelatedContact": "CURRENT",
          "SourceEndpoint": {
            "Address": "${cdref:phonenumber:main-did}",
            "Type": "CONNECT_PHONENUMBER_ARN"
          }
        },
        "Transitions": {
          "NextAction": "leave-message",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "leave-message"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "text-from-attributes",
        "Type": "StartOutboundChatContact",
        "Parameters": {
          "ContactFlowArn": "$.Attributes.smsFlowArn",
          "ContactSubtype": "connect:SMS",
          "DestinationEndpoint": {
            "Address": "+15555550101",
            "Type": "TELEPHONE_NUMBER"
          },
          "SourceEndpoint": {
            "Address": "$.Attributes.smsNumberArn",
            "Type": "CONNECT_PHONENUMBER_ARN"
          }
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "leave-message",
        "Type": "MessageParticipant",
        "Parameters": {
          "Text": "The call reached voicemail."
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "EndFlowExecution",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  },
  "layout": {
    "check-progress": {
      "x": 540,
      "y": 20
    },
    "choose-route": {
      "x": 20,
      "y": 20
    },
    "done": {
      "x": 1320,
      "y": 20
    },
    "greet": {
      "x": 800,
      "y": 20
    },
    "leave-message": {
      "x": 1060,
      "y": 180
    },
    "place-call": {
      "x": 280,
      "y": 20
    },
    "place-call-via-sip": {
      "x": 280,
      "y": 180
    },
    "text-back": {
      "x": 800,
      "y": 180
    },
    "text-from-attributes": {
      "x": 800,
      "y": 340
    }
  },
  "refs": [
    {
      "token": "${cdref:flow:sms-follow-up}",
      "type": "flow",
      "name": "sms-follow-up"
    },
    {
      "token": "${cdref:phonenumber:main-did}",
      "type": "phonenumber",
      "name": "main-did"
    }
  ]
}
