{
  "flowdoc": "0.2",
  "kind": "flow",
  "name": "linear",
  "connectType": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "greet",
    "Actions": [
      {
        "Identifier": "greet",
        "Type": "MessageParticipant",
        "Parameters": {
          "Text": "Hello."
        },
        "Transitions": {
          "NextAction": "ask",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "end"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "ask",
        "Type": "MessageParticipant",
        "Parameters": {
          "Text": "How can we help?"
        },
        "Transitions": {
          "NextAction": "end",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "end"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "end",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
