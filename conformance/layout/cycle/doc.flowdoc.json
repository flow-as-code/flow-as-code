{
  "flowdoc": "0.2",
  "kind": "flow",
  "name": "cycle",
  "connectType": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "ask",
    "Actions": [
      {
        "Identifier": "ask",
        "Type": "MessageParticipant",
        "Parameters": {
          "Text": "Say again."
        },
        "Transitions": {
          "NextAction": "check",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "check",
        "Type": "Loop",
        "Parameters": {
          "LoopCount": "3"
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": [
            {
              "NextAction": "ask",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "ContinueLooping"
                ]
              }
            }
          ]
        }
      },
      {
        "Identifier": "done",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
