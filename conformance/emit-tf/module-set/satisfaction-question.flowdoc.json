{
  "flowdoc": "0.2",
  "kind": "module",
  "name": "satisfaction-question",
  "connectType": "MODULE",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "ask",
    "Actions": [
      {
        "Identifier": "ask",
        "Type": "GetParticipantInput",
        "Parameters": {
          "InputTimeLimitSeconds": "5",
          "StoreInput": "False",
          "Text": "Press 1 if we solved your problem, or 2 if we did not."
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "InputTimeLimitExceeded",
              "NextAction": "done"
            },
            {
              "ErrorType": "NoMatchingCondition",
              "NextAction": "done"
            },
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": [
            {
              "NextAction": "done",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "1"
                ]
              }
            },
            {
              "NextAction": "done",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "2"
                ]
              }
            }
          ]
        }
      },
      {
        "Identifier": "done",
        "Type": "EndFlowModuleExecution",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  },
  "layout": {
    "ask": {
      "x": 20,
      "y": 20
    },
    "done": {
      "x": 280,
      "y": 20
    }
  },
  "refs": []
}
