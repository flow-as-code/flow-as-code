{
  "flowdoc": "0.1",
  "kind": "flow",
  "name": "support-line",
  "connectType": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "welcome",
    "Actions": [
      {
        "Identifier": "welcome",
        "Type": "MessageParticipant",
        "Parameters": {
          "Text": "Thanks for calling support."
        },
        "Transitions": {
          "NextAction": "set-queue",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "survey"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "set-queue",
        "Type": "UpdateContactTargetQueue",
        "Parameters": {
          "QueueId": "${cdref:queue:appointments}"
        },
        "Transitions": {
          "NextAction": "survey",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "survey"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "survey",
        "Type": "InvokeFlowModule",
        "Parameters": {
          "FlowModuleId": "${cdref:module:after-call-survey@prod}"
        },
        "Transitions": {
          "NextAction": "hang-up",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "hang-up"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "hang-up",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  },
  "layout": {
    "hang-up": {
      "x": 800,
      "y": 20
    },
    "set-queue": {
      "x": 280,
      "y": 20
    },
    "survey": {
      "x": 540,
      "y": 20
    },
    "welcome": {
      "x": 20,
      "y": 20
    }
  },
  "refs": [
    {
      "token": "${cdref:module:after-call-survey@prod}",
      "type": "module",
      "name": "after-call-survey",
      "alias": "prod"
    },
    {
      "token": "${cdref:queue:appointments}",
      "type": "queue",
      "name": "appointments"
    }
  ]
}
