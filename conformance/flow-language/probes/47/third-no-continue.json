{
  "description": "Rule 47: TransferParticipantToThirdParty without ContinueFlowExecution, which the catalog requires from the export; the removal alone, with the catch-all only.",
  "type": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "TransferParticipantToThirdParty",
        "Parameters": {
          "ThirdPartyConnectionTimeLimitSeconds": "30",
          "ThirdPartyPhoneNumber": "$.Attributes.deskPhone"
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
