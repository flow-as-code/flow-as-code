{
  "description": "Rule 47: ContinueFlowExecution False without NextAction. The flow ends when the transfer succeeds in this form, so the service may not require one; the catalog requires it until this result.",
  "type": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "TransferParticipantToThirdParty",
        "Parameters": {
          "ContinueFlowExecution": "False",
          "ThirdPartyConnectionTimeLimitSeconds": "30",
          "ThirdPartyPhoneNumber": "$.Attributes.deskPhone"
        },
        "Transitions": {
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
