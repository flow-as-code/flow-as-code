{
  "description": "Rule 47: TransferParticipantToThirdParty in a customer whisper flow, which the page does not list; the catalog forbids it.",
  "type": "CUSTOMER_WHISPER",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "TransferParticipantToThirdParty",
        "Parameters": {
          "ContinueFlowExecution": "True",
          "ThirdPartyConnectionTimeLimitSeconds": "30",
          "ThirdPartyPhoneNumber": "$.Attributes.deskPhone"
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "CallFailed",
              "NextAction": "done"
            },
            {
              "ErrorType": "ConnectionTimeLimitExceeded",
              "NextAction": "done"
            },
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "EndFlowExecution",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
