{
  "description": "Rule 47: LoadContactContent in an outbound whisper flow, one of the ten flow types the admin guide lists.",
  "type": "OUTBOUND_WHISPER",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "LoadContactContent",
        "Parameters": {
          "ContentType": "EmailMessage"
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "EndFlowExecution",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
