{
  "description": "Rule 47: LoadContactContent with a ContentType the page does not list (EmailAttachment), which the 0.3 schema clause refuses; settles whether the service holds the page's one value.",
  "type": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "LoadContactContent",
        "Parameters": {
          "ContentType": "EmailAttachment"
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
