{
  "description": "Rule 43: GetCustomerProfile searched by a named profile key (PhoneNumber), the form AWS's step-by-step guide flows write; neither of the page's forms.",
  "type": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "GetCustomerProfile",
        "Parameters": {
          "ProfileRequestData": {
            "PhoneNumber": "$.CustomerEndpoint.Address"
          },
          "ProfileResponseData": [
            "FirstName"
          ]
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            },
            {
              "ErrorType": "MultipleFoundError",
              "NextAction": "done"
            },
            {
              "ErrorType": "NoneFoundError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
