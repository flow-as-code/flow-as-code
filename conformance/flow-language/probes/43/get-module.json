{
  "description": "Rule 43: GetCustomerProfile in a flow module.",
  "type": "MODULE",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Settings": {},
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "GetCustomerProfile",
        "Parameters": {
          "ProfileRequestData": {
            "IdentifierName": "_phone",
            "IdentifierValue": "$.CustomerEndpoint.Address"
          },
          "ProfileResponseData": [
            "FirstName"
          ]
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            },
            {
              "ErrorType": "MultipleFoundError",
              "NextAction": "done"
            },
            {
              "ErrorType": "NoneFoundError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "EndFlowModuleExecution",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
