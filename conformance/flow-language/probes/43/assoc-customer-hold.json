{
  "description": "Rule 43: AssociateContactToCustomerProfile in a customer hold flow; the admin guide's block allows all flow types.",
  "type": "CUSTOMER_HOLD",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "AssociateContactToCustomerProfile",
        "Parameters": {
          "ProfileRequestData": {
            "ProfileId": "$.Customer.ProfileId",
            "ContactId": "$.ContactId"
          },
          "ProfileResponseData": []
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "MessageParticipantIteratively",
        "Parameters": {
          "Messages": [
            {
              "Text": "Please hold."
            }
          ]
        },
        "Transitions": {
          "Errors": [],
          "Conditions": []
        }
      }
    ]
  }
}
