{
  "description": "Rule 43: GetCustomerProfile with the catalog's required set alone: one identifier, no ProfileResponseData, and the catch-all without MultipleFoundError or NoneFoundError; expected accepted if the two lookup branches are optional.",
  "type": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "GetCustomerProfile",
        "Parameters": {
          "ProfileRequestData": {
            "IdentifierName": "_phone",
            "IdentifierValue": "$.CustomerEndpoint.Address"
          }
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
