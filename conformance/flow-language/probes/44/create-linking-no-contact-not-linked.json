{
  "description": "Rule 44: CreateCase linking the contact without ContactNotLinked, a removal alone; the catalog requires it when LinkContactToCase is \"true\".",
  "type": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "CreateCase",
        "Parameters": {
          "LinkContactToCase": "true",
          "CaseTemplateId": "{{CASE_TEMPLATE_ID}}"
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
