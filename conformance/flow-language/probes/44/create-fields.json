{
  "description": "Rule 44: CreateCase with the domain's text and single-select fields by id and two system fields, the fixture's shape; expected accepted.",
  "type": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "CreateCase",
        "Parameters": {
          "LinkContactToCase": "false",
          "CaseTemplateId": "{{CASE_TEMPLATE_ID}}",
          "CaseRequestFields": {
            "{{CASE_TEXT_FIELD_ID}}": "$.Attributes.reason",
            "{{CASE_SELECT_FIELD_ID}}": "{{CASE_SELECT_OPTION}}",
            "customer_id": "$.Customer.ProfileARN",
            "summary": "$.Attributes.summary"
          }
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
