{
  "description": "Rule 44: UpdateCase setting the domain's text and single-select fields by id; expected accepted.",
  "type": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "UpdateCase",
        "Parameters": {
          "LinkContactToCase": "false",
          "CaseId": "$.Case.case_id",
          "CaseRequestFields": {
            "{{CASE_TEXT_FIELD_ID}}": "$.Attributes.reason",
            "{{CASE_SELECT_FIELD_ID}}": "{{CASE_SELECT_OPTION}}"
          }
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
