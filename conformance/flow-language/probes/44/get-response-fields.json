{
  "description": "Rule 44: GetCase storing system fields and the domain's text field by id; expected accepted.",
  "type": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "GetCase",
        "Parameters": {
          "LinkContactToCase": "false",
          "GetLastUpdatedCase": "true",
          "CaseRequestFields": {
            "customer_id": "$.Customer.ProfileARN"
          },
          "CaseResponseFields": [
            "case_id",
            "status",
            "{{CASE_TEXT_FIELD_ID}}"
          ]
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "MultipleFound",
              "NextAction": "done"
            },
            {
              "ErrorType": "NoneFound",
              "NextAction": "done"
            },
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
