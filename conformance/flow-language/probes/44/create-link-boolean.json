{
  "description": "Rule 44: CreateCase with LinkContactToCase as the JSON boolean true rather than the string the published flows write.",
  "type": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "CreateCase",
        "Parameters": {
          "LinkContactToCase": true,
          "CaseTemplateId": "{{CASE_TEMPLATE_ID}}"
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "ContactNotLinked",
              "NextAction": "done"
            },
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
