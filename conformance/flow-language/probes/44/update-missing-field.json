{
  "description": "Rule 44: UpdateCase setting a field id the domain does not have.",
  "type": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "UpdateCase",
        "Parameters": {
          "LinkContactToCase": "false",
          "CaseId": "$.Case.case_id",
          "CaseRequestFields": {
            "{{MISSING_CASE_FIELD_ID}}": "x"
          }
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
