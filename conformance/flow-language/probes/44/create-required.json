{
  "description": "Rule 44: CreateCase not linking, with its template and no request fields, a NextAction and the catch-all: the required set alone; expected accepted. Run before the Cases domain is associated, it is also the probe of an instance with no Cases domain.",
  "type": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "CreateCase",
        "Parameters": {
          "LinkContactToCase": "false",
          "CaseTemplateId": "{{CASE_TEMPLATE_ID}}"
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
