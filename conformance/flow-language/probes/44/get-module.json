{
  "description": "Rule 44: GetCase in a flow module; the page: \"can be used in any type of flow\".",
  "type": "MODULE",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Settings": {},
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "GetCase",
        "Parameters": {
          "LinkContactToCase": "false",
          "GetLastUpdatedCase": "true",
          "CaseRequestFields": {
            "customer_id": "$.Customer.ProfileARN"
          }
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "MultipleFound",
              "NextAction": "done"
            },
            {
              "ErrorType": "NoneFound",
              "NextAction": "done"
            },
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "EndFlowModuleExecution",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
