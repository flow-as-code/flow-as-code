{
  "description": "Rule 44: CreateCase in a customer hold flow; the page: \"can be used in any type of flow\".",
  "type": "CUSTOMER_HOLD",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "CreateCase",
        "Parameters": {
          "LinkContactToCase": "false",
          "CaseTemplateId": "{{CASE_TEMPLATE_ID}}"
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "MessageParticipantIteratively",
        "Parameters": {
          "Messages": [
            {
              "Text": "Please hold."
            }
          ]
        },
        "Transitions": {
          "Errors": [],
          "Conditions": []
        }
      }
    ]
  }
}
