              "NextAction": "done"
            }
          ],
          "Conditions": [
            {
              "NextAction": "done",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "CallAnswered"
                ]
              }
            },
            {
              "NextAction": "done",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "VoicemailBeep"
                ]
              }
            },
            {
              "NextAction": "done",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "VoicemailNoBeep"
                ]
              }
            },
            {
              "NextAction": "done",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "NotDetected"
                ]
              }
            }
          ]
        }
      },
      {
        "Identifier": "done",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
