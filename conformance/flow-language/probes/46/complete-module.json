{
  "description": "Rule 46: CompleteOutboundCall in the class's form in a flow module; the admin guide's block names the outbound whisper flow alone and the action page none, so the result decides whether the restriction is the service's.",
  "type": "MODULE",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Settings": {},
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "CompleteOutboundCall",
        "Parameters": {
          "CallerId": {
            "Number": "{{DID_NUMBER}}"
          }
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "EndFlowModuleExecution",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
