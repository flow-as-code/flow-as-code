{
  "description": "Rule 46: StartOutboundChatContact with the required set alone and the sandbox's claimed voice DID, which is not SMS-enabled, as the source by ARN; with sms-required, the probe of a number that is not SMS-enabled. Compare with sms-required-set-alone, which differs only in the source.",
  "type": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "StartOutboundChatContact",
        "Parameters": {
          "SourceEndpoint": {
            "Address": "arn:aws:connect:{{REGION}}:{{ACCOUNT}}:phone-number/{{DID_ID}}",
            "Type": "CONNECT_PHONENUMBER_ARN"
          },
          "DestinationEndpoint": {
            "Address": "$.CustomerEndpoint.Address",
            "Type": "TELEPHONE_NUMBER"
          },
          "ContactFlowArn": "arn:aws:connect:{{REGION}}:{{ACCOUNT}}:instance/{{INSTANCE}}/contact-flow/{{FLOW_ID}}",
          "ContactSubtype": "connect:SMS"
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
