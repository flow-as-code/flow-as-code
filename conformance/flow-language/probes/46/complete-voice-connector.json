{
  "description": "Rule 46: CompleteOutboundCall in the page's VoiceConnector form with an invented Chime voice connector ARN and a 30 second limit; decides whether the create validates the connector (owner decision 4 keeps the form generic either way).",
  "type": "OUTBOUND_WHISPER",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "CompleteOutboundCall",
        "Parameters": {
          "VoiceConnector": {
            "VoiceConnectorType": "ChimeConnector",
            "VoiceConnectorArn": "arn:aws:chime:{{REGION}}:{{ACCOUNT}}:vc/fac-probe-invented",
            "FromUser": "+15555550101",
            "ToUser": "+15555550102"
          },
          "ConnectionTimeLimitSeconds": "30"
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "EndFlowExecution",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
