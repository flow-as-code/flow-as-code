{
  "description": "Rule 46: StartOutboundChatContact in the required set without ContactFlowArn, a required key removed alone. The source is read from an attribute, so no number's SMS capability is checked and the result answers this probe's question alone.",
  "type": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "StartOutboundChatContact",
        "Parameters": {
          "SourceEndpoint": {
            "Address": "$.Attributes.smsNumberArn",
            "Type": "CONNECT_PHONENUMBER_ARN"
          },
          "DestinationEndpoint": {
            "Address": "$.CustomerEndpoint.Address",
            "Type": "TELEPHONE_NUMBER"
          },
          "ContactSubtype": "connect:SMS"
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
