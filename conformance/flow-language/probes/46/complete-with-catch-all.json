{
  "description": "Rule 46: CompleteOutboundCall in the class's form with NoMatchingError added; the page and the admin guide say there is no error, and rule 37 found the service refusing NoMatchingError on UpdateContactRecordingBehavior, whose page also says None.",
  "type": "OUTBOUND_WHISPER",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "CompleteOutboundCall",
        "Parameters": {
          "CallerId": {
            "Number": "{{DID_NUMBER}}"
          }
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "EndFlowExecution",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
