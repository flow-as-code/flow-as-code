                  "VoicemailBeep"
                ]
              }
            },
            {
              "NextAction": "done",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "VoicemailNoBeep"
                ]
              }
            },
            {
              "NextAction": "done",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "NotDetected"
                ]
              }
            }
          ]
        }
      },
      {
        "Identifier": "done",
