{
  "description": "Rule 41: in a customer hold flow, which the page excludes (\"It is not supported in hold flows\"); a refusal shows the service enforces it at create.",
  "type": "CUSTOMER_HOLD",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "UpdateContactMediaStreamingBehavior",
        "Parameters": {
          "MediaStreamingState": "Enabled",
          "Participants": [
            {
              "ParticipantType": "Customer",
              "MediaDirections": [
                "From",
                "To"
              ]
            }
          ],
          "MediaStreamType": "Audio"
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "MessageParticipantIteratively",
        "Parameters": {
          "Messages": [
            {
              "Text": "Please hold."
            }
          ]
        },
        "Transitions": {
          "Errors": [],
          "Conditions": []
        }
      }
    ]
  }
}
