{
  "description": "Rule 41: in an outbound whisper flow, which the admin guide lists and the action page's Restrictions omit; the result decides the catalog's flowTypes.",
  "type": "OUTBOUND_WHISPER",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "UpdatePreviousContactParticipantState",
        "Parameters": {
          "PreviousContactParticipantState": "AgentOnHold"
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "EndFlowExecution",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
