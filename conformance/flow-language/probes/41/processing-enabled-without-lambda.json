{
  "description": "Rule 41: processing enabled with no LambdaProcessorARN; a refusal is a shape (the ARN required when ProcessingEnabled is True) the catalog does not record yet.",
  "type": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "UpdateContactMediaProcessing",
        "Parameters": {
          "ChatProcessor": {
            "ProcessingEnabled": "True",
            "ChatProcessorSettings": {
              "DeliverUnprocessedMessages": "True"
            }
          }
        },
        "Transitions": {
          "NextAction": "disconnect",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "disconnect"
            },
            {
              "ErrorType": "ChannelMismatch",
              "NextAction": "disconnect"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "disconnect",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
