{
  "description": "Rule 45: UpdateRoutingCriteria with the catalog's required set alone: one step holding only its Expression, a single AttributeCondition on the instance's predefined attribute, no Expiry, with next and the catch-all.",
  "type": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "UpdateRoutingCriteria",
        "Parameters": {
          "RoutingCriteria": {
            "Steps": [
              {
                "Expression": {
                  "AttributeCondition": {
                    "Name": "{{PREDEFINED_ATTRIBUTE}}",
                    "Value": "{{PREDEFINED_VALUE}}",
                    "ProficiencyLevel": 1,
                    "ComparisonOperator": "NumberGreaterOrEqualTo"
                  }
                }
              }
            ]
          }
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
