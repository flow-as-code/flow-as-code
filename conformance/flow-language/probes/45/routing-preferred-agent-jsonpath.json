{
  "description": "Rule 45: A preferred-agent requirement whose agent is the admin guide's manual-mode example, $.Customer.CalculatedAttributes._last_agent_id, in place of a literal user id.",
  "type": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "UpdateContactRoutingCriteria",
        "Parameters": {
          "RoutingCriteria": {
            "Steps": [
              {
                "Expression": {
                  "AttributeCondition": {
                    "ComparisonOperator": "Match",
                    "MatchCriteria": {
                      "AgentsCriteria": {
                        "AgentIds": [
                          "$.Customer.CalculatedAttributes._last_agent_id"
                        ]
                      }
                    }
                  }
                },
                "Expiry": {
                  "DurationInSeconds": "30"
                }
              },
              {
                "Expression": {
                  "AttributeCondition": {
                    "Name": "{{PREDEFINED_ATTRIBUTE}}",
                    "Value": "{{PREDEFINED_VALUE}}",
                    "ProficiencyLevel": 1,
                    "ComparisonOperator": "NumberGreaterOrEqualTo"
                  }
                }
              }
            ]
          }
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
