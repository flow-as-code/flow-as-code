{
  "description": "Rule 42: CreateTask with ScheduledTime as a JSONPath, the admin guide's Set date and time using attribute form and the one the class writes.",
  "type": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "CreateTask",
        "Parameters": {
          "ContactFlowId": "arn:aws:connect:{{REGION}}:{{ACCOUNT}}:instance/{{INSTANCE}}/contact-flow/{{TASK_FLOW_ID}}",
          "Name": "Probe task",
          "ScheduledTime": "$.Attributes.scheduledTaskTime"
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
