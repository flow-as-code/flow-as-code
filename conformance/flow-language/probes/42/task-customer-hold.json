{
  "description": "Rule 42: CreateTask in a customer hold flow, the page's \"all contact flow types\".",
  "type": "CUSTOMER_HOLD",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "CreateTask",
        "Parameters": {
          "ContactFlowId": "arn:aws:connect:{{REGION}}:{{ACCOUNT}}:instance/{{INSTANCE}}/contact-flow/{{TASK_FLOW_ID}}",
          "Name": "Probe task"
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "MessageParticipantIteratively",
        "Parameters": {
          "Messages": [
            {
              "Text": "Please hold."
            }
          ]
        },
        "Transitions": {
          "Errors": [],
          "Conditions": []
        }
      }
    ]
  }
}
