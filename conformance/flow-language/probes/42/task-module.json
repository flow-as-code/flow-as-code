{
  "description": "Rule 42: CreateTask in a flow module, the page's \"all contact flow types\".",
  "type": "MODULE",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Settings": {},
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "CreateTask",
        "Parameters": {
          "ContactFlowId": "arn:aws:connect:{{REGION}}:{{ACCOUNT}}:instance/{{INSTANCE}}/contact-flow/{{TASK_FLOW_ID}}",
          "Name": "Probe task"
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "EndFlowModuleExecution",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
