{
  "description": "Rule 42: CreateTask with ContactFlowId as a bare id, the page's \"A flow ID or flow ARN\".",
  "type": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "CreateTask",
        "Parameters": {
          "ContactFlowId": "{{TASK_FLOW_ID}}",
          "Name": "Probe task"
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
