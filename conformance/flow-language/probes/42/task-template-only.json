{
  "description": "Rule 42: CreateTask with a template ARN and a Name and no flow, the admin guide's Use template form for a template that carries a flow; the catalog records ContactFlowId optional on that reading.",
  "type": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "probe",
    "Actions": [
      {
        "Identifier": "probe",
        "Type": "CreateTask",
        "Parameters": {
          "Name": "Probe task",
          "TaskTemplateId": "arn:aws:connect:{{REGION}}:{{ACCOUNT}}:instance/{{INSTANCE}}/task-template/{{TASK_TEMPLATE_ID}}"
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "done"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  }
}
