coverage/
package-lock.json

# Scratch directories the tests write generated sources into and delete again.
.vitest/

# Golden files are byte-compared; formatting them would break the tests.
conformance/

# A byte copy of conformance/schema/flowdoc-0.1.schema.json, shipped inside the
# CLI because conformance/ is not published. Formatting it would make it stop
# being a copy, which packages/cli/src/schema.test.ts asserts it is.
packages/cli/schema/

# Same again for the document `flow-cli init` writes: a byte copy of
# conformance/demo/appointment-line.flowdoc.json, held to that by
# packages/cli/src/init.test.ts.
packages/cli/template/

# A byte copy of conformance/flow-language/catalog.json, kept inside core so
# the lint rules can read it in the studio's worker; held to the original by
# packages/core/src/catalog.test.ts.
packages/core/src/catalog/

# FlowDocs in an example's flows/ are what flow-cli writes: canonical
# serializer output, which Prettier would reformat. (Hidden from Prettier by
# the old unanchored flows/ rule in .gitignore until 2026-09-28.)
examples/*/flows/
